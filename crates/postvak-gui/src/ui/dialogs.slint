// The small windows over the panes: Keys and History. Esc closes them through the app, the X here.
import { LineEdit, ListView, ScrollView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { Heading, HoverFill, IconButton, TextButton } from "common.slint";
import { AccountFields, AccountForm } from "account.slint";

export struct KeyHelp {
    keys: string,
    what: string,
}

// A titled box with a close button; its content goes under the title.
export component Dialog inherits Rectangle {
    in property <string> title;
    in property <string> close-icon;
    callback close();

    background: Theme.pane.background;
    border-color: Theme.pane.border;
    border-width: 1px;
    border-radius: Theme.radius;
    drop-shadow-blur: Theme.pad;
    drop-shadow-color: #0004;
    accessible-role: groupbox;
    accessible-label: root.title;

    // Clicks stay in the dialog.
    TouchArea { }

    VerticalLayout {
        padding: Theme.inset;
        spacing: Theme.pad;
        HorizontalLayout {
            Heading {
                accessible-role: none;
                text: root.title;
                vertical-alignment: center;
            }
            Rectangle { horizontal-stretch: 1; }
            IconButton {
                icon: root.close-icon;
                name: "Close";
                hint: "Close · Esc";
                palette: Theme.pane;
                clicked => { root.close(); }
            }
        }
        @children
    }
}

export component KeysDialog {
    in property <[KeyHelp]> keys;
    in property <string> close-icon;
    // The most height the window has room for; the keys scroll beyond it.
    in property <length> room;
    callback close();
    width: 560px;
    Dialog {
        title: "Keys";
        close-icon: root.close-icon;
        close => { root.close(); }
        scroll := ScrollView {
            height: min(rows.preferred-height, root.room - 2 * Theme.inset - Theme.control - Theme.pad);
            rows := VerticalLayout {
                width: scroll.visible-width;
                spacing: Theme.pad / 2;
                for key in root.keys: HorizontalLayout {
                    spacing: Theme.inset;
                    Text {
                        width: 200px;
                        text: key.keys;
                        font-weight: 600;
                        color: Theme.pane.strong;
                        wrap: word-wrap;
                    }
                    // A definite width, so the wrapped lines count in the row's height.
                    Text {
                        width: scroll.visible-width - 200px - Theme.inset;
                        text: key.what;
                        color: Theme.pane.text;
                        wrap: word-wrap;
                    }
                }
            }
        }
    }
}

export component HistoryDialog {
    in property <[string]> lines;
    in property <string> close-icon;
    callback close();
    width: 520px;
    Dialog {
        title: "History";
        close-icon: root.close-icon;
        close => { root.close(); }
        if root.lines.length == 0: Text {
            text: "Nothing has happened yet.";
            color: Theme.pane.muted;
        }
        if root.lines.length > 0: ScrollView {
            height: min(360px, history.preferred-height);
            history := VerticalLayout {
                for line in root.lines: Text {
                    text: line;
                    color: Theme.pane.text;
                    wrap: word-wrap;
                }
            }
        }
    }
}

// The `m` picker: type to filter the folders, Enter or a click moves.
export component MoveDialog {
    in property <[string]> targets;
    in property <string> close-icon;
    callback filter-edited(string);
    callback accepted();
    callback chosen(int);
    callback close();
    width: 320px;
    Dialog {
        title: "Move to";
        close-icon: root.close-icon;
        close => { root.close(); }
        LineEdit {
            height: Theme.control;
            placeholder-text: "Folder";
            accessible-label: "Folder";
            init => { self.focus(); }
            edited(text) => { root.filter-edited(text); }
            accepted => { root.accepted(); }
        }
        ScrollView {
            height: min(320px, names.preferred-height);
            names := VerticalLayout {
                for target[i] in root.targets: TouchArea {
                    height: Theme.row;
                    accessible-role: button;
                    accessible-label: target;
                    accessible-action-default => { root.chosen(i); }
                    clicked => { root.chosen(i); }
                    HoverFill {
                        hovered: parent.has-hover;
                        fill: Theme.pane.hover;
                    }
                    Text {
                        accessible-role: none;
                        x: Theme.pad;
                        text: target;
                        color: Theme.pane.text;
                        vertical-alignment: center;
                    }
                }
            }
        }
    }
}

// The raw message, a row per line, with Copy.
export component SourceDialog {
    in property <[string]> rows;
    // The whole cleaned text, for Copy.
    in property <string> text;
    in property <length> widest;
    in property <string> close-icon;
    callback close();
    width: 720px;
    height: 480px;
    Dialog {
        title: "Message source";
        close-icon: root.close-icon;
        close => { root.close(); }
        HorizontalLayout {
            TextButton {
                text: "Copy";
                framed: true;
                palette: Theme.pane;
                clicked => {
                    buffer.select-all();
                    buffer.copy();
                }
            }
            Rectangle { horizontal-stretch: 1; }
        }
        buffer := TextInput {
            visible: false;
            height: 0;
            read-only: true;
            text: root.text;
            accessible-role: none;
        }
        ListView {
            vertical-stretch: 1;
            content-width: max(self.visible-width, root.widest);
            for row in root.rows: Text {
                height: Theme.row;
                text: row;
                font-family: Theme.mono-font;
                color: Theme.pane.text;
                vertical-alignment: center;
            }
        }
    }
}

// The add-account form over the panes. Esc or the X closes it; the app keeps it open while a save runs.
export component AccountDialog {
    in property <string> error;
    in property <bool> saving;
    in property <string> close-icon;
    callback save(AccountFields);
    callback close();
    width: 480px;
    Dialog {
        title: "Add account";
        close-icon: root.close-icon;
        close => { root.close(); }
        AccountForm {
            error: root.error;
            saving: root.saving;
            save(fields) => { root.save(fields); }
        }
    }
}

// Asks before a rule run expunges mail from the server; Esc, the X or Cancel closes it.
export component ApplyConfirmDialog {
    in property <string> warning;
    in property <string> close-icon;
    callback confirm();
    callback close();
    width: 480px;
    Dialog {
        title: "Apply to existing mail";
        close-icon: root.close-icon;
        close => { root.close(); }
        Text {
            text: root.warning;
            color: Theme.pane.text;
            wrap: word-wrap;
        }
        HorizontalLayout {
            spacing: Theme.pad;
            Rectangle { horizontal-stretch: 1; }
            TextButton {
                text: "Cancel";
                palette: Theme.pane;
                framed: true;
                clicked => { root.close(); }
            }
            TextButton {
                text: "Delete and apply";
                palette: Theme.pane;
                framed: true;
                clicked => { root.confirm(); }
            }
        }
    }
}
