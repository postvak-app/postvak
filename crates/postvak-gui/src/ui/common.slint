// Small pieces the panes share.
import { Theme, Palette } from "theme.slint";

/* The hover background, which fades in and out; put it first, under the content.

Hide it while the widget draws another state (selected, pressed) so that state shows at once rather than after a fade. */
export component HoverFill inherits Rectangle {
    in property <bool> hovered;
    in property <color> fill;

    border-radius: Theme.pad / 2;
    // Fading to the same colour made transparent, so it does not pass through grey.
    background: root.hovered ? root.fill : root.fill.transparentize(100%);
    animate background {
        duration: Theme.hover-fade;
        easing: ease-out;
    }
}

// A 1px divider across its parent, in `palette`'s border colour.
export component Hairline inherits Rectangle {
    in property <Palette> palette: Theme.pane;

    height: 1px;
    background: root.palette.border;
}

/* A frameless square button with a Phosphor glyph, named for screen readers and tests, with its hint on hover.

With a `label` it is a framed button with the label instead of the glyph: the message actions while several messages
are selected, where six glyphs and labels would not fit a narrow reader. */
export component IconButton inherits Rectangle {
    in property <string> icon;
    in property <string> name;
    in property <string> hint;
    in property <string> label;
    // Shown instead of `hint` while disabled, when set.
    in property <string> disabled-hint;
    in property <bool> enabled: true;
    in property <Palette> palette: Theme.frame;
    in property <length> size: Theme.control;
    in property <length> glyph-size: Theme.icon;
    callback clicked();

    width: root.label == "" ? root.size : layout.preferred-width;
    height: root.size;
    border-radius: root.size == Theme.control ? Theme.pad / 2 : Theme.pad;
    border-width: root.label == "" ? 0px : 1px;
    border-color: root.palette.border;
    background: root.enabled && touch.pressed ? root.palette.pressed : root.label == "" ? transparent : root.palette.faint;
    accessible-role: button;
    accessible-label: root.name;
    accessible-description: root.hint;
    accessible-enabled: root.enabled;
    accessible-action-default => {
        if (root.enabled) {
            root.clicked();
        }
    }

    HoverFill {
        visible: root.enabled && !touch.pressed;
        border-radius: root.border-radius;
        hovered: touch.has-hover;
        fill: root.palette.hover;
    }

    touch := TouchArea {
        clicked => {
            if (root.enabled) {
                root.clicked();
            }
        }
        Tooltip { text: @markdown("\{!root.enabled && root.disabled-hint != "" ? root.disabled-hint : root.hint}"); }
    }

    layout := HorizontalLayout {
        alignment: center;
        padding-left: root.label == "" ? 0px : Theme.pad * 3 / 2;
        padding-right: self.padding-left;
        spacing: Theme.pad;
        opacity: root.enabled ? 1 : 0.4;
        if root.label == "": Text {
            accessible-role: none;
            text: root.icon;
            font-family: Theme.icon-font;
            font-size: root.glyph-size;
            color: root.palette.text;
            vertical-alignment: center;
        }
        if root.label != "": Text {
            accessible-role: none;
            text: root.label;
            color: root.palette.text;
            vertical-alignment: center;
        }
    }
}

// Text that acts as a button: the theme switch, the update link.
export component TextButton inherits Rectangle {
    in property <string> text;
    in property <bool> selected;
    in property <bool> enabled: true;
    // The hover hint while enabled; `disabled-hint` replaces it while disabled.
    in property <string> hint;
    // The hover hint while the button is disabled: why it is.
    in property <string> disabled-hint;
    in property <Palette> palette: Theme.frame;
    in property <color> text-color: root.selected ? root.palette.strong : root.palette.text;
    in property <string> text-font: Theme.text-font;
    // An outlined pill for an action in a pane, rather than a choice in a bar.
    in property <bool> framed;
    // A filled pill: the one action a screen leads with.
    in property <bool> primary;
    // A filled pill for an action that loses mail or rules.
    in property <bool> danger;
    // Its text starts at its left edge, in line with the text above it; the hover fill still frames it.
    in property <bool> flush;
    // Phosphor glyphs before and after the text, such as an arrow for an action that leaves Postvak.
    in property <string> icon;
    in property <string> end-icon;
    // A pill in the reader's denser type; and a small one, as low as a row, for a card's own action.
    in property <bool> compact;
    in property <bool> small;
    callback clicked();

    property <bool> pill: root.framed || root.primary || root.danger;
    property <color> fill: root.primary ? Theme.brand : root.danger ? root.palette.error : transparent;

    height: root.small ? Theme.row + Theme.pad / 4 : root.pill ? Theme.control + Theme.pad / 2 : Theme.control;
    border-radius: root.pill ? self.height / 2 : Theme.pad / 2;
    border-width: root.framed && !root.primary && !root.danger ? 1px : 0px;
    border-color: root.palette.border;
    // A chosen option is pressed in, so the selection fill stays for the list row and folder alone.
    background: root.selected ? root.palette.pressed : root.fill;
    drop-shadow-color: root.primary && root.enabled ? Theme.brand-glow : transparent;
    drop-shadow-blur: Theme.pad * 2;
    drop-shadow-offset-y: Theme.pad * 3 / 4;
    opacity: root.enabled ? 1 : 0.5;
    accessible-role: button;
    accessible-label: root.text;
    accessible-item-selected: root.selected;
    accessible-enabled: root.enabled;
    accessible-description: root.enabled ? root.hint : root.disabled-hint;
    accessible-action-default => {
        if (root.enabled) {
            root.clicked();
        }
    }
    HoverFill {
        visible: root.enabled && !root.selected;
        border-radius: root.border-radius;
        hovered: touch.has-hover;
        fill: root.primary ? Theme.brand-hover : root.danger ? root.palette.error.darker(20%) : root.palette.hover;
    }
    HorizontalLayout {
        padding-left: root.small ? Theme.pad * 3 / 2 : root.compact ? Theme.pad * 7 / 4 : root.pill ? 2 * Theme.pad : root.flush ? 0 : Theme.pad / 2;
        padding-right: root.small ? Theme.pad * 3 / 2 : root.compact ? Theme.pad * 7 / 4 : root.pill ? 2 * Theme.pad : Theme.pad / 2;
        spacing: Theme.pad * 3 / 4;
        if root.icon != "": Text {
            accessible-role: none;
            text: root.icon;
            font-family: Theme.icon-font;
            font-size: Theme.icon - Theme.pad / 4;
            color: root.text-color;
            vertical-alignment: center;
        }
        Text {
            accessible-role: none;
            text: root.text;
            color: root.primary ? Theme.on-brand : root.danger ? root.palette.faint : root.text-color;
            font-family: root.text-font;
            font-size: root.small ? Theme.small-size : root.compact ? Theme.compact-size : Theme.text-size;
            font-weight: root.selected || root.pill ? 600 : 500;
            vertical-alignment: center;
        }
        if root.end-icon != "": Text {
            accessible-role: none;
            text: root.end-icon;
            font-family: Theme.icon-font;
            font-size: Theme.small-size;
            color: root.text-color;
            vertical-alignment: center;
        }
    }
    touch := TouchArea {
        clicked => {
            if (root.enabled) {
                root.clicked();
            }
        }
        if (root.enabled ? root.hint : root.disabled-hint) != "": Tooltip { text: @markdown("\{root.enabled ? root.hint : root.disabled-hint}"); }
    }
}

// A small muted line that explains what is around it.
export component Note inherits Text {
    font-size: Theme.small-size;
    color: Theme.pane.muted;
    wrap: word-wrap;
}

// Shown in place of a pane's content: a heading in the display face, centred, with an optional muted line under it.
export component EmptyState inherits VerticalLayout {
    // A Phosphor glyph above the heading.
    in property <string> icon;
    in property <string> title;
    in property <string> note;
    spacing: Theme.pad;
    if root.icon != "": VerticalLayout {
        padding-bottom: Theme.pad;
        Text {
            accessible-role: none;
            text: root.icon;
            font-family: Theme.icon-font;
            font-size: 7 * Theme.pad;
            color: Theme.brand-soft;
            horizontal-alignment: center;
        }
    }
    Text {
        text: root.title;
        font-family: Theme.heading-font;
        font-weight: 600;
        font-size: Theme.empty-size;
        letter-spacing: -0.02 * Theme.empty-size;
        color: Theme.pane.heading;
        horizontal-alignment: center;
        wrap: word-wrap;
    }
    if root.note != "": Text {
        text: root.note;
        font-size: Theme.lede-size;
        color: Theme.pane.muted;
        horizontal-alignment: center;
        wrap: word-wrap;
    }
    @children
}

// A key drawn as a key, inline with text.
export component Keycap inherits Rectangle {
    in property <string> key;
    in property <Palette> palette: Theme.pane;
    height: 9 * Theme.pad / 4;
    width: max(self.height, label.preferred-width + Theme.pad);
    border-radius: Theme.pad / 2;
    border-width: 1px;
    border-color: root.palette.border;
    background: root.palette.faint;
    label := Text {
        accessible-role: none;
        text: root.key;
        font-family: Theme.mono-font;
        font-size: 11px;
        color: root.palette.muted;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

/* After an action, at the foot of a pane: what it did, and Undo with its key while it can still be undone.

The window ends it after a while; the pointer on it keeps it. Its parent places it and gives it at most its own width. */
export component Toast inherits Rectangle {
    in property <string> text;
    in property <bool> undo;
    callback undo-clicked();
    callback hover(bool);
    property <bool> shown;
    init => { root.shown = true; }

    opacity: root.shown ? 1 : 0;
    animate opacity {
        duration: Theme.state-fade;
        easing: ease-out;
    }
    preferred-width: layout.preferred-width;
    height: Theme.control + Theme.pad;
    border-radius: self.height / 2;
    border-width: 1px;
    border-color: Theme.frame.border;
    background: Theme.frame.background;
    drop-shadow-blur: 3 * Theme.pad;
    drop-shadow-offset-y: Theme.pad / 2;
    drop-shadow-color: Theme.shadow;
    accessible-role: AccessibleRole.text;
    accessible-label: root.text;

    TouchArea {
        changed has-hover => { root.hover(self.has-hover); }
    }
    layout := HorizontalLayout {
        padding-left: Theme.inset;
        padding-right: root.undo ? Theme.pad : Theme.inset;
        spacing: Theme.pad;
        Text {
            text: root.text;
            color: Theme.frame.text;
            vertical-alignment: center;
            overflow: elide;
        }
        if root.undo: VerticalLayout {
            alignment: center;
            TextButton {
                text: "Undo";
                small: true;
                palette: Theme.frame;
                text-color: Theme.frame.accent;
                hint: "Put back what this did";
                clicked => { root.undo-clicked(); }
            }
        }
        if root.undo: VerticalLayout {
            alignment: center;
            Keycap {
                key: "z";
                palette: Theme.frame;
            }
        }
    }
}

// A heading in the display face and the pane's palette.
export component Heading inherits Text {
    font-family: Theme.heading-font;
    font-weight: 600;
    font-size: Theme.heading-size;
    color: Theme.pane.heading;
}

// Accent text that acts as a link; a button for screen readers.
export component Link inherits TouchArea {
    in property <string> text;
    mouse-cursor: pointer;
    accessible-role: button;
    accessible-label: root.text;
    accessible-action-default => { root.clicked(); }
    HorizontalLayout {
        alignment: start;
        Text {
            accessible-role: none;
            text: root.text;
            color: Theme.pane.accent;
            overflow: elide;
            vertical-alignment: center;
        }
    }
}

// An on/off switch in the pane's colours; `name` is what screen readers and tests call it. The owner flips `checked`.
export component Switch inherits Rectangle {
    in property <bool> checked;
    in property <string> name;
    callback toggled(bool);

    width: 3 * Theme.row / 2;
    height: 3 * Theme.row / 4;
    border-radius: self.height / 2;
    background: root.checked ? Theme.pane.accent : Theme.pane.border;
    accessible-role: switch;
    accessible-label: root.name;
    accessible-checkable: true;
    accessible-checked: root.checked;
    accessible-action-default => { root.toggled(!root.checked); }

    // The knob takes the pane's background when on, so it reads on the accent in both modes.
    Rectangle {
        width: parent.height * 3 / 4;
        height: self.width;
        x: root.checked ? parent.width - parent.height / 2 - self.width / 2 : parent.height / 2 - self.width / 2;
        y: (parent.height - self.height) / 2;
        border-radius: self.width / 2;
        background: root.checked ? Theme.pane.background : Theme.pane.muted;
        animate x { duration: Theme.state-fade; easing: ease-out; }
    }
    TouchArea {
        mouse-cursor: pointer;
        clicked => { root.toggled(!root.checked); }
    }
}

// The sender's logo cut to a circle, or else their initials on their colour. The software renderer does not clip to
// a rounded rectangle, so the logo's corners are painted over in `under`, the colour behind the avatar.
export component Avatar inherits Rectangle {
    in property <string> initials;
    in property <int> tint;
    in property <image> logo;
    in property <bool> has-logo;
    in property <color> under: Theme.pane.background;
    in property <length> font-size: Theme.text-size;
    border-radius: self.width / 2;
    background: root.has-logo ? transparent : Theme.avatars[mod(root.tint, Theme.avatars.length)];
    if root.has-logo: Image {
        accessible-role: none;
        width: parent.width;
        height: parent.height;
        source: root.logo;
        image-fit: cover;
    }
    if root.has-logo: Path {
        width: parent.width;
        height: parent.height;
        viewbox-width: 2;
        viewbox-height: 2;
        fill: root.under;
        fill-rule: evenodd;
        commands: "M 0 0 L 2 0 L 2 2 L 0 2 Z M 1 0 A 1 1 0 1 0 1 2 A 1 1 0 1 0 1 0 Z";
    }
    if !root.has-logo: Text {
        accessible-role: none;
        text: root.initials;
        font-size: root.font-size;
        font-weight: 600;
        color: Theme.pane.heading;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

/* A line of text that can be selected and copied, cut short when it does not fit.

A TextInput cannot elide, so the elided Text shows it and an invisible read-only TextInput over it takes the selection. */
export component SelectableLine {
    in property <string> text;
    in property <brush> color;
    in property <string> font-family;
    in property <length> font-size;
    in property <int> font-weight;
    in property <length> letter-spacing;
    in property <TextVerticalAlignment> vertical-alignment;
    min-width: 0;
    min-height: shown.preferred-height;
    preferred-width: shown.preferred-width;
    Rectangle {
        clip: true;
        shown := Text {
            accessible-role: none;
            width: 100%;
            height: 100%;
            text: root.text;
            color: root.color;
            font-family: root.font-family;
            font-size: root.font-size;
            font-weight: root.font-weight;
            letter-spacing: root.letter-spacing;
            vertical-alignment: root.vertical-alignment;
            overflow: elide;
        }
        TextInput {
            width: 100%;
            height: 100%;
            text: root.text;
            read-only: true;
            color: transparent;
            font-family: root.font-family;
            font-size: root.font-size;
            font-weight: root.font-weight;
            letter-spacing: root.letter-spacing;
            vertical-alignment: root.vertical-alignment;
            selection-background-color: Theme.pane.selected;
            selection-foreground-color: Theme.pane.on-accent;
            accessible-label: root.text;
        }
    }
}
