// Small pieces the panes share.
import { Theme, Palette } from "theme.slint";

/* The hover background, which fades in and out; put it first, under the content.

Hide it while the widget draws another state (selected, pressed) so that state shows at once rather than after a fade. */
export component HoverFill inherits Rectangle {
    in property <bool> hovered;
    in property <color> fill;

    border-radius: Theme.pad / 2;
    // Fading to the same colour made transparent, so it does not pass through grey.
    background: root.hovered ? root.fill : root.fill.transparentize(100%);
    animate background {
        duration: Theme.hover-fade;
        easing: ease-out;
    }
}

// A 1px divider across its parent, in `palette`'s border colour.
export component Hairline inherits Rectangle {
    in property <Palette> palette: Theme.pane;

    height: 1px;
    background: root.palette.border;
}

/* A frameless square button with a Phosphor glyph, named for screen readers and tests, with its hint on hover.

With a `label` it is a framed button with the label instead of the glyph: the message actions while several messages
are selected, where six glyphs and labels would not fit a narrow reader. */
export component IconButton inherits Rectangle {
    in property <string> icon;
    in property <string> name;
    in property <string> hint;
    in property <string> label;
    // Shown instead of `hint` while disabled, when set.
    in property <string> disabled-hint;
    in property <bool> enabled: true;
    in property <Palette> palette: Theme.frame;
    in property <length> size: Theme.control;
    in property <length> glyph-size: Theme.icon;
    callback clicked();

    width: root.label == "" ? root.size : layout.preferred-width;
    height: root.size;
    border-radius: root.size == Theme.control ? Theme.pad / 2 : Theme.pad;
    border-width: root.label == "" ? 0px : 1px;
    border-color: root.palette.border;
    background: root.enabled && touch.pressed ? root.palette.pressed : root.label == "" ? transparent : root.palette.faint;
    accessible-role: button;
    accessible-label: root.name;
    accessible-description: root.hint;
    accessible-enabled: root.enabled;
    accessible-action-default => {
        if (root.enabled) {
            root.clicked();
        }
    }

    HoverFill {
        visible: root.enabled && !touch.pressed;
        border-radius: root.border-radius;
        hovered: touch.has-hover;
        fill: root.palette.hover;
    }

    touch := TouchArea {
        clicked => {
            if (root.enabled) {
                root.clicked();
            }
        }
        Tooltip { text: @markdown("\{!root.enabled && root.disabled-hint != "" ? root.disabled-hint : root.hint}"); }
    }

    layout := HorizontalLayout {
        alignment: center;
        padding-left: root.label == "" ? 0px : Theme.pad * 3 / 2;
        padding-right: self.padding-left;
        spacing: Theme.pad;
        opacity: root.enabled ? 1 : 0.4;
        if root.label == "": Text {
            accessible-role: none;
            text: root.icon;
            font-family: Theme.icon-font;
            font-size: root.glyph-size;
            color: root.palette.text;
            vertical-alignment: center;
        }
        if root.label != "": Text {
            accessible-role: none;
            text: root.label;
            color: root.palette.text;
            vertical-alignment: center;
        }
    }
}

// Text that acts as a button: the theme switch, the update link.
export component TextButton inherits Rectangle {
    in property <string> text;
    in property <bool> selected;
    in property <bool> enabled: true;
    // The hover hint while enabled; `disabled-hint` replaces it while disabled.
    in property <string> hint;
    // The hover hint while the button is disabled: why it is.
    in property <string> disabled-hint;
    in property <Palette> palette: Theme.frame;
    in property <color> text-color: root.selected ? root.palette.strong : root.palette.text;
    in property <string> text-font: Theme.text-font;
    // A filled button for an action in a pane, rather than a choice in a bar.
    in property <bool> framed;
    // Its text starts at its left edge, in line with the text above it; the hover fill still frames it.
    in property <bool> flush;
    callback clicked();

    height: Theme.row;
    border-radius: Theme.pad / 2;
    // A chosen option is pressed in, so the selection fill stays for the list row and folder alone.
    background: root.selected ? root.palette.pressed : root.framed ? root.palette.hover : transparent;
    opacity: root.enabled ? 1 : 0.5;
    accessible-role: button;
    accessible-label: root.text;
    accessible-item-selected: root.selected;
    accessible-enabled: root.enabled;
    accessible-description: root.enabled ? root.hint : root.disabled-hint;
    accessible-action-default => {
        if (root.enabled) {
            root.clicked();
        }
    }
    HoverFill {
        visible: root.enabled && !root.selected;
        hovered: touch.has-hover;
        fill: root.framed ? root.palette.pressed : root.palette.hover;
    }
    HorizontalLayout {
        padding-left: root.framed ? Theme.pad : root.flush ? 0 : Theme.pad / 2;
        padding-right: root.framed ? Theme.pad : Theme.pad / 2;
        Text {
            accessible-role: none;
            text: root.text;
            color: root.text-color;
            font-family: root.text-font;
            font-weight: root.selected ? 600 : 500;
            vertical-alignment: center;
        }
    }
    touch := TouchArea {
        clicked => {
            if (root.enabled) {
                root.clicked();
            }
        }
        if (root.enabled ? root.hint : root.disabled-hint) != "": Tooltip { text: @markdown("\{root.enabled ? root.hint : root.disabled-hint}"); }
    }
}

// A small muted line that explains what is around it.
export component Note inherits Text {
    font-size: Theme.small-size;
    color: Theme.pane.muted;
    wrap: word-wrap;
}

// A heading in the display face and the pane's palette.
export component Heading inherits Text {
    font-family: Theme.heading-font;
    font-weight: 600;
    font-size: Theme.heading-size;
    color: Theme.pane.heading;
}

// Accent text that acts as a link; a button for screen readers.
export component Link inherits TouchArea {
    in property <string> text;
    mouse-cursor: pointer;
    accessible-role: button;
    accessible-label: root.text;
    accessible-action-default => { root.clicked(); }
    HorizontalLayout {
        alignment: start;
        Text {
            accessible-role: none;
            text: root.text;
            color: Theme.pane.accent;
            overflow: elide;
            vertical-alignment: center;
        }
    }
}

// An on/off switch in the pane's colours; `name` is what screen readers and tests call it. The owner flips `checked`.
export component Switch inherits Rectangle {
    in property <bool> checked;
    in property <string> name;
    callback toggled(bool);

    width: 3 * Theme.row / 2;
    height: 3 * Theme.row / 4;
    border-radius: self.height / 2;
    background: root.checked ? Theme.pane.accent : Theme.pane.border;
    accessible-role: switch;
    accessible-label: root.name;
    accessible-checkable: true;
    accessible-checked: root.checked;
    accessible-action-default => { root.toggled(!root.checked); }

    // The knob takes the pane's background when on, so it reads on the accent in both modes.
    Rectangle {
        width: parent.height * 3 / 4;
        height: self.width;
        x: root.checked ? parent.width - parent.height / 2 - self.width / 2 : parent.height / 2 - self.width / 2;
        y: (parent.height - self.height) / 2;
        border-radius: self.width / 2;
        background: root.checked ? Theme.pane.background : Theme.pane.muted;
        animate x { duration: Theme.state-fade; easing: ease-out; }
    }
    TouchArea {
        mouse-cursor: pointer;
        clicked => { root.toggled(!root.checked); }
    }
}
