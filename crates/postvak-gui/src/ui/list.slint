// The message list: the search field, the title with the filter menu, then a row per thread. `rows.rs` makes the rows'
// texts; this file only places them.
import { LineEdit, ListView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { EmptyState, Heading, HoverFill, IconButton } from "common.slint";

export struct RowData {
    unread: bool,
    // The mark's or flag's glyph, or empty.
    marker: string,
    member: bool,
    // The account, in All inboxes.
    tag: string,
    who: string,
    subject: string,
    date: string,
    // The cursor row.
    selected: bool,
    marked: bool,
    // New mail, in the list since its last change: the row fades in.
    arrived: bool,
    // The accessible name, from `list::row_text`.
    name: string,
    // A label drawn above the row, on the first close match of a search; empty otherwise.
    section: string,
    // The right-click menu's three groups, from `list::menu`.
    menu-read: [string],
    menu-move: [string],
    menu-file: [string],
}

component ListRow inherits Rectangle {
    in property <RowData> data;
    // `extend` with Shift held, `toggle` with Cmd on macOS or Ctrl elsewhere.
    callback clicked(/* extend */ bool, /* toggle */ bool);
    property <KeyboardModifiers> held;

    property <color> ink: data.selected ? Theme.pane.on-accent : Theme.pane.text;
    property <length> indent: data.member ? Theme.inset : 0px;
    // 1 while unread, 0 once read: the dot and the sender's and subject's ink follow it.
    property <float> unread-level;
    // Whether `unread-level` fades; the ListView reuses a row for another message as it scrolls, and that must not fade.
    property <bool> fade;
    // The message the row last showed.
    property <string> shown;
    // 0 while new mail is about to fade in, else 1; the list sets the row's opacity from it.
    out property <float> appear: 1;
    property <bool> appearing;
    animate unread-level {
        duration: root.fade ? Theme.state-fade : 0ms;
        easing: ease-out;
    }
    animate appear {
        duration: root.appearing ? Theme.arrive-fade : 0ms;
        easing: ease-out;
    }
    init => { root.show(); }
    changed data => { root.show(); }

    function show() {
        let message = data.tag + "\n" + data.who + "\n" + data.subject + "\n" + data.date;
        root.fade = message == root.shown;
        if !root.fade && data.arrived {
            root.appearing = false;
            root.appear = 0;
            root.appearing = true;
            root.appear = 1;
        }
        root.shown = message;
        root.unread-level = data.unread ? 1 : 0;
    }

    property <length> strip: data.section == "" ? 0px : Theme.row;
    height: Theme.list-row + root.strip;
    accessible-role: list-item;
    accessible-label: data.name;
    accessible-item-selected: data.selected;
    accessible-action-default => { root.clicked(false, false); }

    // The "Close matches" strip above the first close hit.
    if data.section != "": Text {
        x: Theme.pad * 3 / 2;
        y: 0;
        height: Theme.row;
        text: data.section;
        font-size: Theme.small-size;
        color: Theme.pane.muted;
        vertical-alignment: center;
    }

    card := Rectangle {
        y: root.strip;
        height: Theme.list-row;
        border-radius: Theme.pad;
        // A marked row is a lighter shade of the cursor's, apart from the hover fill.
        background: data.selected ? Theme.pane.selected : data.marked ? Theme.pane.selected.mix(Theme.pane.panel, 60%) : transparent;

    HoverFill {
        visible: !data.selected && !data.marked;
        border-radius: Theme.pad;
        hovered: touch.has-hover;
        fill: Theme.pane.hover;
    }

    touch := TouchArea {
        pointer-event(event) => {
            if event.kind == PointerEventKind.down {
                root.held = event.modifiers;
            }
        }
        clicked => { root.clicked(root.held.shift, root.held.control); }
    }

    HorizontalLayout {
        padding-left: Theme.pad * 3 / 2;
        padding-right: Theme.pad * 3 / 2;
        padding-top: (Theme.list-row - 2 * Theme.row) / 2;
        padding-bottom: self.padding-top;
        spacing: Theme.pad * 3 / 2;

        // The unread dot, on the sender's line.
        Rectangle {
            width: Theme.pad;
            Rectangle {
                opacity: root.unread-level;
                y: (Theme.row - self.height) / 2;
                width: Theme.pad;
                height: self.width;
                border-radius: self.width / 2;
                background: Theme.pane.highlight;
            }
        }

        VerticalLayout {
            padding-left: root.indent;
            HorizontalLayout {
                height: Theme.row;
                spacing: Theme.pad;
                if data.tag != "": Text {
                    accessible-role: none;
                    max-width: 80px;
                    text: data.tag;
                    font-size: Theme.small-size;
                    color: data.selected ? Theme.pane.secondary : Theme.pane.muted;
                    overflow: elide;
                    vertical-alignment: center;
                }
                // Every sender is semibold; unread ones are darker.
                Text {
                    accessible-role: none;
                    horizontal-stretch: 1;
                    text: data.who;
                    font-weight: 600;
                    color: data.selected ? root.ink : Theme.pane.strong.mix(Theme.pane.secondary, root.unread-level);
                    overflow: elide;
                    vertical-alignment: center;
                }
                // The mark's or flag's glyph.
                if data.marker != "": Text {
                    accessible-role: none;
                    text: data.marker;
                    font-family: Theme.icon-font;
                    font-size: Theme.icon * 3 / 4;
                    color: Theme.pane.highlight;
                    vertical-alignment: center;
                }
                Text {
                    accessible-role: none;
                    text: data.date;
                    font-size: Theme.small-size;
                    color: data.selected ? Theme.pane.secondary : Theme.pane.muted;
                    vertical-alignment: center;
                }
            }
            Text {
                accessible-role: none;
                height: Theme.row;
                text: data.subject;
                color: data.selected ? root.ink : Theme.pane.secondary;
                overflow: elide;
                vertical-alignment: center;
            }
        }
    }
    }
}

export component ListPane inherits Rectangle {
    in property <string> title;
    // The filter's index: All, Unread, Flagged, Attachments.
    in property <int> filter;
    // The filter's name beside the title, or empty for All.
    in property <string> filter-label;
    in property <string> filter-icon;
    in property <string> search-icon;
    // The search field's hover hint, with its key.
    in property <string> search-key;
    in property <bool> searching;
    in property <string> search-hint;
    in property <string> results;
    // Shown instead of rows, or empty, under `empty-icon`.
    in property <string> empty;
    in property <string> empty-icon;
    in property <[RowData]> rows;
    in property <int> marked-count;
    in-out property <length> list-y;
    out property <length> list-height: list.visible-height;
    callback row-clicked(int, bool, bool);
    callback filter-clicked(int);
    callback start-search();
    // The payload a dragged row carries.
    pure callback drag-data(int) -> data-transfer;
    // The pill beside the pointer: the rows that move, the row's subject, its fill and text colours.
    pure callback drag-image(int, string, color, color) -> image;
    // A row's menu item: the row, the item's group, its place in the group.
    callback row-menu(int, int, int);
    callback search-edited(string);
    callback search-accepted();
    callback search-focus(bool);
    callback scrolled();

    VerticalLayout {
        VerticalLayout {
            padding: Theme.inset;
            padding-bottom: Theme.pad;
            spacing: Theme.pad * 3 / 2;

            // Looks like the field it opens; `/` opens it too.
            if !root.searching: Rectangle {
                height: Theme.action;
                border-radius: Theme.pad;
                border-width: 1px;
                border-color: Theme.pane.border;
                background: search.has-hover ? Theme.pane.faint : Theme.pane.background;
                accessible-role: button;
                accessible-label: "Search";
                accessible-description: root.search-key;
                accessible-action-default => { root.start-search(); }
                search := TouchArea {
                    mouse-cursor: text;
                    clicked => { root.start-search(); }
                    Tooltip { text: @markdown("\{root.search-key}"); }
                }
                HorizontalLayout {
                    padding-left: Theme.pad * 3 / 2;
                    spacing: Theme.pad;
                    Text {
                        accessible-role: none;
                        text: root.search-icon;
                        font-family: Theme.icon-font;
                        font-size: Theme.icon;
                        color: Theme.pane.muted;
                        vertical-alignment: center;
                    }
                    Text {
                        accessible-role: none;
                        text: "Search mail";
                        color: Theme.pane.muted;
                        vertical-alignment: center;
                    }
                    Rectangle { horizontal-stretch: 1; }
                }
            }

            if root.searching: VerticalLayout {
                spacing: Theme.pad / 2;
                LineEdit {
                    height: Theme.action;
                    placeholder-text: root.search-hint;
                    accessible-label: root.search-hint;
                    init => { self.focus(); }
                    edited(text) => { root.search-edited(text); }
                    accepted => { root.search-accepted(); }
                    changed has-focus => { root.search-focus(self.has-focus); }
                }
                // One line: a wrapped second line would sit under the first row, as the list's height does not follow it.
                Text {
                    text: root.results;
                    color: Theme.pane.muted;
                    overflow: elide;
                }
            }

            if !root.searching && root.title != "": HorizontalLayout {
                height: Theme.action;
                spacing: Theme.pad;
                Heading {
                    text: root.title;
                    font-size: Theme.title-size;
                    vertical-alignment: center;
                    overflow: elide;
                }
                // The chosen filter, which a click clears.
                if root.filter-label != "": VerticalLayout {
                    alignment: center;
                    Rectangle {
                        height: Theme.row;
                        width: chip.preferred-width;
                        border-radius: self.height / 2;
                        background: chip-touch.has-hover ? Theme.pane.pressed : Theme.pane.selected;
                        accessible-role: button;
                        accessible-label: "Clear filter";
                        accessible-description: root.filter-label;
                        accessible-action-default => { root.filter-clicked(0); }
                        chip-touch := TouchArea {
                            clicked => { root.filter-clicked(0); }
                        }
                        chip := HorizontalLayout {
                            padding-left: Theme.pad + Theme.pad / 4;
                            padding-right: self.padding-left;
                            spacing: Theme.pad / 2;
                            Text {
                                accessible-role: none;
                                text: root.filter-label;
                                font-size: Theme.small-size;
                                color: Theme.pane.on-accent;
                                vertical-alignment: center;
                            }
                            Text {
                                accessible-role: none;
                                text: "×";
                                color: Theme.pane.on-accent;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
                Rectangle { horizontal-stretch: 1; }
                filter-menu := ContextMenuArea {
                    width: Theme.action;
                    height: Theme.action;
                    Menu {
                        for label[i] in ["All", "Unread", "Flagged", "Attachments"]: MenuItem {
                            title: label;
                            checkable: true;
                            checked: root.filter == i;
                            activated => { root.filter-clicked(i); }
                        }
                    }
                    IconButton {
                        icon: root.filter-icon;
                        name: "Filter messages";
                        hint: "Show all, unread, flagged or with attachments";
                        palette: Theme.pane;
                        size: Theme.action;
                        glyph-size: Theme.large-icon;
                        clicked => { filter-menu.show({ x: 0, y: self.height }); }
                    }
                    // A filter other than All is on.
                    if root.filter-label != "": Rectangle {
                        x: parent.width - Theme.pad - self.width / 2;
                        y: Theme.pad - self.height / 2;
                        width: Theme.pad * 3 / 4;
                        height: self.width;
                        border-radius: self.width / 2;
                        background: Theme.pane.accent;
                    }
                }
            }
        }

        VerticalLayout {
            padding-left: Theme.pad;
            padding-right: Theme.pad;
            padding-bottom: Theme.pad;
            list := ListView {
                vertical-stretch: 1;
                content-y <=> root.list-y;
                init => { root.scrolled(); }
                changed content-y => { root.scrolled(); }
                changed visible-height => { root.scrolled(); }
                // The menu sits above the row: a TouchArea takes every button's press before its parent sees it.
                for row[i] in root.rows: Rectangle {
                    height: Theme.list-row;
                    // Dragging onto a folder moves the row; a click still reaches it.
                    drag := DragArea {
                        allow-move: true;
                        data: root.drag-data(i);
                        drag-image: root.drag-image(row.marked ? root.marked-count : 1, row.subject, Theme.frame.highlight, Theme.frame.background);
                        drag-image-offset-x: -Theme.pad / 1px * 2;
                        drag-image-offset-y: -Theme.pad / 1px;
                        ListRow {
                            opacity: (drag.dragging ? 0.4 : 1) * self.appear;
                            data: row;
                            clicked(extend, toggle) => { root.row-clicked(i, extend, toggle); }
                        }
                    }
                    ContextMenuArea {
                        Menu {
                            for title[j] in row.menu-read: MenuItem {
                                title: title;
                                activated => { root.row-menu(i, 0, j); }
                            }
                            MenuSeparator { }
                            for title[j] in row.menu-move: MenuItem {
                                title: title;
                                activated => { root.row-menu(i, 1, j); }
                            }
                            MenuSeparator { }
                            for title[j] in row.menu-file: MenuItem {
                                title: title;
                                activated => { root.row-menu(i, 2, j); }
                            }
                        }
                    }
                }
            }
        }
    }

    if root.empty != "": EmptyState {
        icon: root.empty-icon;
        x: Theme.inset;
        y: (root.height - self.preferred-height) / 2;
        height: self.preferred-height;
        width: root.width - 2 * Theme.inset;
        title: root.empty;
    }
}
