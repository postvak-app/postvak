// The body pane: the message actions, then the message's header, attachments, and the text with its links; or, with
// several messages selected, the selection. `body.rs` words it, `toolbar.rs` the actions.
import { ListView, ScrollView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { EmptyState, Hairline, Heading, HoverFill, IconButton, Keycap, Link, TextButton } from "common.slint";

// A message action: its glyph, its accessible name, its hover hint and the label it shows beside the glyph while
// several messages are selected.
export struct ToolButton {
    icon: string,
    name: string,
    hint: string,
    label: string,
}

// An attachment of the shown message: its file name and its size, such as "2 KB".
export struct AttachmentData {
    name: string,
    size: string,
}

// One condition of a rule, worded, and whether the shown message meets it.
export struct WhyLine {
    text: string,
    met: bool,
}

// What rules did to the shown message, worded by `body::provenance`; `shown` is false when they did nothing.
export struct ProvenanceData {
    shown: bool,
    // The newest action: "Moved to", the folder it names, the rule and when; and the whole sentence for screen readers.
    verb: string,
    target: string,
    rule: string,
    when: string,
    sentence: string,
    // The rule is no longer in rules.toml.
    removed: bool,
    // Where Move back returns the message, or empty when it cannot.
    move-back: string,
    // How many older actions "and N more" lists, whether it lists them now, and every action as a sentence.
    more: int,
    open: bool,
    all: [string],
    // Why? is open, with each condition of the rule.
    why-open: bool,
    why: [WhyLine],
}

// A selected message, as the selection lists it.
export struct SelectedData {
    who: string,
    subject: string,
    date: string,
    unread: bool,
}

export struct BodyInfo {
    // Instead of a message, when set, with a line under it.
    empty: string,
    empty-hint: string,
    subject: string,
    initials: string,
    // Which of `Theme.avatars` the initials sit on.
    tint: int,
    // The sender's logo instead of the initials, when `has-logo`; `logo-key` names it, so it is drawn once.
    logo: image,
    has-logo: bool,
    logo-key: string,
    name: string,
    address: string,
    short-date: string,
    full-date: string,
    to: string,
    cc: string,
    downloaded: bool,
    missing: string,
    has-html: bool,
    shows-html: bool,
    text-note: string,
    // HTML adapted to the dark theme, or that would be: "Original colours" shows; and whether it is on.
    adapts: bool,
    original-colours: bool,
    attachments: [AttachmentData],
    // Listed before the whole message is here: Save waits for it.
    attachments-pending: bool,
    saved: string,
    unsubscribe: bool,
    // The sender accepted the one-click unsubscribe: Delete shows beside the note.
    unsubscribed: bool,
    // There is an address to reply to: Reply shows.
    reply: bool,
    provenance: ProvenanceData,
    links: [string],
}

export struct StripData {
    image: image,
    y: length,
    width: length,
    height: length,
}

// What the HTML page says about remote content.
export enum Remote { none, not-loaded, loading }

export struct PageInfo {
    // Laid out: the page and its strips can show.
    ready: bool,
    // Styled for the dark theme: drawn on the dark page rather than a white one.
    dark: bool,
    width: length,
    height: length,
    remote: Remote,
    // The sender domain whose remote content loads without asking, while it did for this page; or empty.
    remembered: string,
    // The link under the pointer, or empty.
    link: string,
}

// The laid-out HTML page as painted strips. Hover asks which link is under the pointer, a drag selects text, a click
// opens a link; every position is in page points.
component HtmlView inherits VerticalLayout {
    in property <PageInfo> page;
    in property <[StripData]> strips;
    callback width-changed(length);
    callback shown(length, length);
    callback hover(length, length);
    callback leave();
    callback select(length, length, length, length);
    callback clicked(length, length);
    callback load-remote();
    callback forget-remote(string);
    callback open-link();
    callback copy-link();

    spacing: Theme.pad;

    property <length> page-width: max(root.page.width, flick.width);
    // The part of the page in view, in page points.
    property <length> view-top: min(max(0px, -flick.content-y), root.page.height);
    property <length> view-height: max(0px, min(root.page.height, -flick.content-y + flick.height) - root.view-top);

    if root.page.remote == Remote.loading: Text {
        text: "Loading remote content…";
        color: Theme.pane.muted;
    }
    if root.page.remote == Remote.not-loaded: HorizontalLayout {
        spacing: Theme.pad;
        Text {
            text: "Remote content not loaded.";
            color: Theme.pane.muted;
            overflow: elide;
            vertical-alignment: center;
        }
        TextButton {
            text: "Load remote content";
            framed: true;
            palette: Theme.pane;
            clicked => { root.load-remote(); }
        }
        Rectangle { horizontal-stretch: 1; }
    }
    if root.page.remembered != "" && root.page.remote != Remote.not-loaded: HorizontalLayout {
        spacing: Theme.pad;
        Text {
            text: "Remote content loads for " + root.page.remembered + ".";
            color: Theme.pane.muted;
            overflow: elide;
            vertical-alignment: center;
        }
        TextButton {
            text: "Stop loading";
            framed: true;
            palette: Theme.pane;
            accessible-label: "Stop loading remote content from " + root.page.remembered;
            clicked => { root.forget-remote(root.page.remembered); }
        }
        Rectangle { horizontal-stretch: 1; }
    }
    if !root.page.ready: Text {
        text: "Rendering…";
        color: Theme.pane.muted;
    }

    flick := Flickable {
        vertical-stretch: 1;
        // A drag selects text; the wheel and the scroll bars move the page.
        interactive: false;
        content-width: max(root.page.width, self.width);
        content-height: root.page.height;
        init => {
            root.width-changed(self.width);
            root.shown(-self.content-y, -self.content-y + self.height);
        }
        changed width => { root.width-changed(self.width); }
        changed height => { root.shown(-self.content-y, -self.content-y + self.height); }
        changed content-y => { root.shown(-self.content-y, -self.content-y + self.height); }

        // The page's white and its border, drawn only where the view shows them: the software renderer casts every
        // rectangle to 16 bits, so one as tall as a very long message would panic it.
        if root.page.ready: Rectangle {
            x: 0;
            y: root.view-top;
            width: root.page-width;
            height: root.view-height;
            background: root.page.dark ? Theme.night.background : white;
        }
        if root.page.ready: Rectangle {
            x: 0;
            y: root.view-top;
            width: 1px;
            height: root.view-height;
            background: Theme.pane.border;
        }
        if root.page.ready: Rectangle {
            x: root.page-width - 1px;
            y: root.view-top;
            width: 1px;
            height: root.view-height;
            background: Theme.pane.border;
        }
        if root.page.ready: Rectangle {
            x: 0;
            y: 0;
            width: root.page-width;
            height: 1px;
            background: Theme.pane.border;
        }
        if root.page.ready: Rectangle {
            x: 0;
            y: root.page.height - 1px;
            width: root.page-width;
            height: 1px;
            background: Theme.pane.border;
        }
        for strip in root.strips: Image {
            x: 0;
            y: strip.y;
            width: strip.width;
            height: strip.height;
            source: strip.image;
        }
        touch := TouchArea {
            width: max(root.page.width, flick.width);
            height: root.page.height;
            mouse-cursor: root.page.link != "" ? pointer : text;
            accessible-role: none;
            changed mouse-x => { self.track(); }
            changed mouse-y => { self.track(); }
            changed has-hover => {
                if (!self.has-hover) {
                    root.leave();
                }
            }
            clicked => { root.clicked(self.mouse-x, self.mouse-y); }
            function track() {
                if (self.pressed) {
                    root.select(self.pressed-x, self.pressed-y, self.mouse-x, self.mouse-y);
                } else if (self.has-hover) {
                    root.hover(self.mouse-x, self.mouse-y);
                }
            }
            if root.page.link != "": Tooltip { text: @markdown("\{root.page.link}"); }
        }
        // Above the TouchArea, which takes every button's press before its parent sees it.
        ContextMenuArea {
            width: max(root.page.width, flick.width);
            height: root.page.height;
            Menu {
                MenuItem {
                    title: "Open link";
                    enabled: root.page.link != "";
                    activated => { root.open-link(); }
                }
                MenuItem {
                    title: "Copy link";
                    enabled: root.page.link != "";
                    activated => { root.copy-link(); }
                }
            }
        }
    }
}

// A header line: a muted label, then the value.
component HeaderLine inherits HorizontalLayout {
    in property <string> label;
    in property <string> value;
    height: 2 * Theme.pad;
    spacing: Theme.pad / 2;
    Text {
        text: root.label;
        font-size: Theme.small-size;
        color: Theme.pane.muted;
        vertical-alignment: center;
    }
    Text {
        horizontal-stretch: 1;
        text: root.value;
        font-size: Theme.small-size;
        color: Theme.pane.muted;
        overflow: elide;
        vertical-alignment: center;
    }
}

// The sender's logo cut to a circle, or else their initials on their colour. The software renderer does not clip to
// a rounded rectangle, so the logo's corners are painted over in the reader's background instead.
component Avatar inherits Rectangle {
    in property <BodyInfo> info;
    width: Theme.avatar;
    height: Theme.avatar;
    border-radius: self.width / 2;
    background: root.info.has-logo ? transparent : Theme.avatars[root.info.tint];
    if root.info.has-logo: Image {
        accessible-role: none;
        width: parent.width;
        height: parent.height;
        source: root.info.logo;
        image-fit: cover;
    }
    if root.info.has-logo: Path {
        width: parent.width;
        height: parent.height;
        viewbox-width: 2;
        viewbox-height: 2;
        fill: Theme.pane.background;
        fill-rule: evenodd;
        commands: "M 0 0 L 2 0 L 2 2 L 0 2 Z M 1 0 A 1 1 0 1 0 1 2 A 1 1 0 1 0 1 0 Z";
    }
    if !root.info.has-logo: Text {
        accessible-role: none;
        text: root.info.initials;
        font-size: Theme.text-size;
        font-weight: 600;
        color: Theme.pane.heading;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

// One message action in an `ActionGroup`: its glyph, and its label when `labelled`.
component GroupButton inherits Rectangle {
    in property <ToolButton> tool;
    in property <bool> labelled;
    in property <bool> enabled;
    // The first in its group, with no hairline before it.
    in property <bool> first;
    callback clicked();
    background: root.enabled && touch.pressed ? Theme.pane.pressed : transparent;
    accessible-role: button;
    accessible-label: root.tool.name;
    accessible-description: root.tool.hint;
    accessible-enabled: root.enabled;
    accessible-action-default => {
        if (root.enabled) {
            root.clicked();
        }
    }
    HoverFill {
        visible: root.enabled && !touch.pressed;
        border-radius: 0;
        hovered: touch.has-hover;
        fill: Theme.pane.hover;
    }
    touch := TouchArea {
        clicked => {
            if (root.enabled) {
                root.clicked();
            }
        }
        Tooltip { text: @markdown("\{root.tool.hint}"); }
    }
    HorizontalLayout {
        padding-left: Theme.pad * 3 / 2;
        padding-right: self.padding-left;
        spacing: Theme.pad * 3 / 4;
        opacity: root.enabled ? 1 : 0.4;
        Text {
            accessible-role: none;
            text: root.tool.icon;
            font-family: Theme.icon-font;
            font-size: Theme.icon;
            color: Theme.pane.text;
            vertical-alignment: center;
        }
        if root.labelled: Text {
            accessible-role: none;
            text: root.tool.label;
            font-size: Theme.compact-size;
            color: Theme.pane.text;
            vertical-alignment: center;
        }
    }
    // Over the button's left edge rather than beside it, so the hairlines add no width.
    if !root.first: Rectangle {
        x: 0;
        width: 1px;
        background: Theme.pane.border;
    }
}

// Message actions that belong together, in one outlined group with a hairline between them; `clicked` gets the index.
component ActionGroup inherits Rectangle {
    in property <[ToolButton]> buttons;
    in property <bool> labelled;
    in property <bool> enabled;
    callback clicked(int);
    width: buttons-row.preferred-width;
    height: Theme.control + Theme.pad / 2;
    border-radius: Theme.pad;
    border-width: 1px;
    border-color: Theme.pane.border;
    background: Theme.pane.panel;
    clip: true;
    buttons-row := HorizontalLayout {
        for button[i] in root.buttons: HorizontalLayout {
            GroupButton {
                first: i == 0;
                tool: button;
                labelled: root.labelled;
                enabled: root.enabled;
                clicked => { root.clicked(i); }
            }
        }
    }
}

// An attachment as a chip: its glyph, name and size, and a button that saves it; Save as… is on its right-click menu.
component AttachmentChip inherits Rectangle {
    in property <AttachmentData> attachment;
    in property <string> file-icon;
    in property <string> save-icon;
    // Listed before the whole message is here: saving waits for it.
    in property <bool> pending;
    callback save();
    callback save-as();
    property <string> label: root.attachment.name + " (" + root.attachment.size + ")";
    height: Theme.action;
    border-radius: Theme.radius;
    border-width: 1px;
    border-color: Theme.pane.border;
    background: Theme.pane.faint;
    ContextMenuArea {
        Menu {
            MenuItem {
                title: "Save";
                enabled: !root.pending;
                activated => { root.save(); }
            }
            MenuItem {
                title: "Save as…";
                enabled: !root.pending;
                activated => { root.save-as(); }
            }
        }
    }
    HorizontalLayout {
        padding-left: Theme.pad * 3 / 2;
        padding-right: Theme.pad * 3 / 4;
        spacing: Theme.pad;
        Text {
            accessible-role: none;
            text: root.file-icon;
            font-family: Theme.icon-font;
            font-size: Theme.icon;
            color: Theme.pane.secondary;
            vertical-alignment: center;
        }
        Text {
            accessible-role: text;
            accessible-label: root.label;
            text: root.attachment.name;
            color: Theme.pane.text;
            vertical-alignment: center;
        }
        Text {
            accessible-role: none;
            text: root.attachment.size;
            color: Theme.pane.muted;
            vertical-alignment: center;
        }
        VerticalLayout {
            alignment: center;
            IconButton {
                icon: root.save-icon;
                name: "Save " + root.label;
                // What a screen reader hears too, so it says why the button is disabled.
                hint: root.pending ? "Downloading the message…" : "Save to Downloads";
                enabled: !root.pending;
                palette: Theme.pane;
                size: Theme.control - Theme.pad / 4;
                clicked => { root.save(); }
            }
        }
    }
}

// Reply and the More menu: what else can be done with the shown message.
component ReplyAndMore inherits HorizontalLayout {
    in property <BodyInfo> info;
    in property <string> more-icon;
    in property <string> reply-icon;
    in property <string> external-icon;
    callback reply();
    callback toggle-html();
    callback toggle-original-colours();
    callback unsubscribe();
    callback save-eml();
    callback open-source();
    spacing: Theme.pad;
    if root.info.reply: VerticalLayout {
        alignment: center;
        TextButton {
            text: "Reply";
            icon: root.reply-icon;
            end-icon: root.external-icon;
            hint: "Reply in your mail app";
            framed: true;
            compact: true;
            palette: Theme.pane;
            clicked => { root.reply(); }
        }
    }
    if root.info.unsubscribe: VerticalLayout {
        alignment: center;
        TextButton {
            text: "Unsubscribe";
            framed: true;
            compact: true;
            palette: Theme.pane;
            clicked => { root.unsubscribe(); }
        }
    }
    VerticalLayout {
        alignment: center;
        more := ContextMenuArea {
            width: Theme.control + Theme.pad / 2;
            height: self.width;
            Menu {
                if root.info.has-html: MenuItem {
                    title: root.info.shows-html ? "Show as text" : "Show as HTML";
                    enabled: root.info.shows-html || root.info.text-note == "";
                    activated => { root.toggle-html(); }
                }
                if root.info.adapts && root.info.shows-html: MenuItem {
                    title: "Original colours";
                    checkable: true;
                    checked: root.info.original-colours;
                    activated => { root.toggle-original-colours(); }
                }
                if root.info.has-html: MenuSeparator { }
                MenuItem {
                    title: "Save .eml";
                    enabled: root.info.downloaded;
                    activated => { root.save-eml(); }
                }
                MenuItem {
                    title: "View source";
                    enabled: root.info.downloaded;
                    activated => { root.open-source(); }
                }
            }
            IconButton {
                icon: root.more-icon;
                name: "More actions";
                hint: "More actions";
                palette: Theme.pane;
                size: parent.width;
                glyph-size: Theme.large-icon;
                // Right-aligned under the button, as wide as the menu is.
                clicked => { more.show({ x: self.width - 30 * Theme.pad, y: self.height + Theme.pad / 2 }); }
            }
        }
    }
}

export component BodyPane inherits Rectangle {
    in property <BodyInfo> info;
    // The cleaned text, or empty while it is missing.
    in property <string> text;
    in property <string> save-icon;
    in property <string> source-icon;
    in property <string> rule-icon;
    in property <string> more-icon;
    in property <string> reply-icon;
    in property <string> external-icon;
    in property <string> file-icon;
    // The glyph above `info.empty`.
    in property <string> empty-icon;
    // The message actions in two groups: those that move the message, then its flag and read state.
    in property <[ToolButton]> actions;
    in property <[ToolButton]> marks;
    in property <bool> actions-enabled;
    // "3 messages selected" while two or more are, else empty; and those messages.
    in property <string> selection-title;
    in property <[SelectedData]> selection;
    // The index of a message action, `marks` counted after `actions`.
    callback action(int);
    callback clear-selection();
    // Write a reply in the user's mail app.
    callback reply();
    // The provenance strip: open the rule that acted, move the message back, list every action, show Why?.
    callback edit-shown-rule();
    callback move-back();
    callback toggle-provenance();
    callback toggle-why();
    callback toggle-html();
    callback toggle-original-colours();
    callback save-eml();
    callback open-source();
    callback unsubscribe();
    callback trash-unsubscribed();
    callback save-attachment(int);
    callback save-attachment-as(int);
    callback open-link(string);
    // Start a rule for mail from this sender.
    callback rule-from();
    in property <PageInfo> page;
    in property <[StripData]> strips;
    callback page-width(length);
    callback page-visible(length, length);
    callback page-hover(length, length);
    callback page-leave();
    callback page-select(length, length, length, length);
    callback page-clicked(length, length);
    callback load-remote();
    callback forget-remote(string);
    callback page-open-link();
    callback page-copy-link();

    property <bool> several: root.selection-title != "";

    if root.info.empty != "" && !root.several: EmptyState {
        x: Theme.inset;
        y: (root.height - self.preferred-height) / 2;
        height: self.preferred-height;
        width: root.width - 2 * Theme.inset;
        icon: root.info.empty-hint != "" ? root.empty-icon : "";
        title: root.info.empty;
        // The hint, with its keys drawn as keys; screen readers get the sentence.
        if root.info.empty-hint != "": HorizontalLayout {
            alignment: center;
            Rectangle {
                accessible-role: AccessibleRole.text;
                accessible-label: root.info.empty-hint;
                HorizontalLayout {
                    spacing: Theme.pad / 2;
                    for part in [
                        { text: "Or press", key: "j" },
                        { text: "for the next one,", key: "/" },
                        { text: "to search,", key: "?" },
                        { text: "for every key.", key: "" },
                    ]: HorizontalLayout {
                        spacing: Theme.pad / 2;
                        Text {
                            accessible-role: none;
                            text: part.text;
                            font-size: Theme.lede-size;
                            color: Theme.pane.muted;
                            vertical-alignment: center;
                        }
                        if part.key != "": VerticalLayout {
                            alignment: center;
                            Keycap { key: part.key; }
                        }
                    }
                }
            }
        }
    }

    // Wide margins while there is room for them.
    property <length> margin: root.width > 80 * Theme.pad ? 2 * Theme.inset : Theme.inset;
    // Room for the moving actions' labels beside the marks, Reply and More on one line: the labels are measured, the
    // glyphs, padding and the rest added.
    property <bool> roomy: root.width - 2 * root.margin >= labels.preferred-width + 4 * (Theme.icon + Theme.pad * 15 / 4) + 2 * (Theme.icon + 3 * Theme.pad) + 21 * Theme.pad + root.unsubscribe-room;
    // The Unsubscribe button's width, while it shows.
    property <length> unsubscribe-room: root.info.unsubscribe ? 14 * Theme.pad : 0px;
    // Room for Reply and More beside the unlabelled actions.
    property <bool> fits: root.width - 2 * root.margin >= 6 * (Theme.icon + 3 * Theme.pad) + 21 * Theme.pad + root.unsubscribe-room;
    labels := Text {
        visible: false;
        accessible-role: none;
        text: root.actions[0].label + root.actions[1].label + root.actions[2].label + root.actions[3].label;
    }

    if root.info.empty == "" || root.several: VerticalLayout {
        padding-left: root.margin;
        padding-right: root.margin;
        padding-top: Theme.inset;
        padding-bottom: Theme.inset;
        spacing: Theme.pad;

        // The message actions in their groups, then Reply and the More menu on the right, or on a line of their own
        // while they do not fit beside them; the moving actions are labelled while there is room, and every one is while
        // several messages are selected.
        Rectangle {
            min-width: 0px;
            height: Theme.control + Theme.pad / 2;
            clip: true;
            HorizontalLayout {
                spacing: Theme.pad;
                VerticalLayout {
                    alignment: center;
                    ActionGroup {
                        buttons: root.actions;
                        labelled: root.several || root.roomy;
                        enabled: root.actions-enabled;
                        clicked(i) => { root.action(i); }
                    }
                }
                VerticalLayout {
                    alignment: center;
                    ActionGroup {
                        buttons: root.marks;
                        labelled: root.several;
                        enabled: root.actions-enabled;
                        clicked(i) => { root.action(root.actions.length + i); }
                    }
                }
                Rectangle { horizontal-stretch: 1; }
                if !root.several && root.fits: ReplyAndMore {
                    info: root.info;
                    more-icon: root.more-icon;
                    reply-icon: root.reply-icon;
                    external-icon: root.external-icon;
                    reply => { root.reply(); }
                    toggle-html => { root.toggle-html(); }
                    toggle-original-colours => { root.toggle-original-colours(); }
                    unsubscribe => { root.unsubscribe(); }
                    save-eml => { root.save-eml(); }
                    open-source => { root.open-source(); }
                }
            }
        }
        if !root.several && !root.fits: HorizontalLayout {
            Rectangle { horizontal-stretch: 1; }
            ReplyAndMore {
                info: root.info;
                more-icon: root.more-icon;
                reply-icon: root.reply-icon;
                external-icon: root.external-icon;
                reply => { root.reply(); }
                toggle-html => { root.toggle-html(); }
                toggle-original-colours => { root.toggle-original-colours(); }
                unsubscribe => { root.unsubscribe(); }
                save-eml => { root.save-eml(); }
                open-source => { root.open-source(); }
            }
        }

        if root.several: VerticalLayout {
            vertical-stretch: 1;
            padding-top: Theme.inset;
            spacing: Theme.pad;
            Heading {
                text: root.selection-title;
                font-size: Theme.subject-size;
                wrap: word-wrap;
            }
            HorizontalLayout {
                height: Theme.row;
                spacing: Theme.pad / 2;
                Text {
                    text: "Actions apply to all of them.";
                    color: Theme.pane.muted;
                    vertical-alignment: center;
                }
                Link {
                    text: "Clear selection";
                    clicked => { root.clear-selection(); }
                }
                Rectangle { horizontal-stretch: 1; }
            }
            Rectangle { height: Theme.pad; }
            Hairline { }
            ListView {
                vertical-stretch: 1;
                for message in root.selection: Rectangle {
                    height: 2 * Theme.row;
                    HorizontalLayout {
                        spacing: Theme.pad * 3 / 2;
                        Text {
                            width: min(10 * Theme.inset, parent.width / 3);
                            text: message.who;
                            font-weight: 600;
                            color: message.unread ? Theme.pane.strong : Theme.pane.secondary;
                            overflow: elide;
                            vertical-alignment: center;
                        }
                        Text {
                            horizontal-stretch: 1;
                            text: message.subject;
                            color: Theme.pane.secondary;
                            overflow: elide;
                            vertical-alignment: center;
                        }
                        Text {
                            text: message.date;
                            font-size: Theme.small-size;
                            color: Theme.pane.muted;
                            vertical-alignment: center;
                        }
                    }
                    Hairline { y: parent.height - 1px; }
                }
            }
        }

        if !root.several: VerticalLayout {
            vertical-stretch: 1;
            padding-top: Theme.pad * 5 / 2;
            spacing: Theme.pad;

            HorizontalLayout {
                spacing: Theme.pad;
                Heading {
                    horizontal-stretch: 1;
                    text: root.info.subject;
                    font-size: Theme.subject-size;
                    wrap: word-wrap;
                }
                if root.info.address != "": VerticalLayout {
                    alignment: start;
                    padding-top: Theme.pad / 4;
                    TextButton {
                        text: "Rule from sender";
                        icon: root.rule-icon;
                        hint: "New rule for mail from this sender";
                        framed: true;
                        compact: true;
                        palette: Theme.pane;
                        clicked => { root.rule-from(); }
                    }
                }
            }

            // The sender beside the avatar, the date centred on it.
            HorizontalLayout {
                padding-top: Theme.pad * 5 / 4;
                padding-bottom: Theme.pad;
                spacing: Theme.pad * 3 / 2;
                VerticalLayout {
                    alignment: start;
                    Avatar { info: root.info; }
                }
                VerticalLayout {
                    alignment: center;
                    spacing: Theme.pad / 4;
                    HorizontalLayout {
                        height: Theme.row - Theme.pad / 2;
                        spacing: Theme.pad;
                        // The address gives way first in a narrow pane.
                        Text {
                            min-width: min(self.preferred-width, 4 * Theme.inset);
                            text: root.info.name;
                            font-weight: 600;
                            color: Theme.pane.strong;
                            overflow: elide;
                            vertical-alignment: center;
                        }
                        if root.info.address != "": Text {
                            text: root.info.address;
                            color: Theme.pane.muted;
                            overflow: elide;
                            vertical-alignment: center;
                        }
                        Rectangle { horizontal-stretch: 1; }
                    }
                    if root.info.to != "": HeaderLine {
                        label: "to";
                        value: root.info.to;
                    }
                    if root.info.cc != "": HeaderLine {
                        label: "cc";
                        value: root.info.cc;
                    }
                }
                VerticalLayout {
                    alignment: center;
                    TouchArea {
                        width: date.preferred-width;
                        height: date.preferred-height;
                        accessible-role: none;
                        Tooltip { text: @markdown("\{root.info.full-date}"); }
                        date := Text {
                            text: root.info.short-date;
                            font-size: Theme.small-size;
                            color: Theme.pane.muted;
                        }
                    }
                }
            }
            if root.info.provenance.shown: VerticalLayout {
                spacing: Theme.pad / 2;
                padding-bottom: Theme.pad * 3 / 4;
                Rectangle {
                    height: Theme.action;
                    border-radius: Theme.pad;
                    background: Theme.pane.panel;
                    HorizontalLayout {
                        padding-left: Theme.pad * 3 / 2;
                        padding-right: self.padding-left;
                        spacing: Theme.pad * 5 / 4;
                        Text {
                            accessible-role: none;
                            text: root.rule-icon;
                            font-family: Theme.icon-font;
                            font-size: Theme.icon;
                            color: Theme.pane.accent;
                            vertical-alignment: center;
                        }
                        Rectangle {
                            horizontal-stretch: 1;
                            min-width: 0;
                            clip: true;
                            accessible-role: AccessibleRole.text;
                            accessible-label: root.info.provenance.sentence;
                            HorizontalLayout {
                                alignment: start;
                                spacing: Theme.pad / 2;
                                Text {
                                    accessible-role: none;
                                    text: root.info.provenance.verb;
                                    font-size: Theme.compact-size;
                                    color: Theme.pane.secondary;
                                    vertical-alignment: center;
                                }
                                if root.info.provenance.target != "": Text {
                                    accessible-role: none;
                                    text: root.info.provenance.target;
                                    font-size: Theme.compact-size;
                                    font-weight: 600;
                                    color: Theme.pane.text;
                                    vertical-alignment: center;
                                }
                                Text {
                                    accessible-role: none;
                                    text: "by rule";
                                    font-size: Theme.compact-size;
                                    color: Theme.pane.secondary;
                                    vertical-alignment: center;
                                }
                                Text {
                                    accessible-role: none;
                                    text: root.info.provenance.rule;
                                    font-family: Theme.mono-font;
                                    font-size: Theme.compact-size;
                                    color: Theme.pane.text;
                                    vertical-alignment: center;
                                }
                                Text {
                                    accessible-role: none;
                                    text: root.info.provenance.when + (root.info.provenance.removed ? " (removed)" : "");
                                    font-size: Theme.compact-size;
                                    color: Theme.pane.secondary;
                                    overflow: elide;
                                    vertical-alignment: center;
                                }
                            }
                        }
                        if root.info.provenance.more > 0: Link {
                            text: "and " + root.info.provenance.more + " more";
                            clicked => { root.toggle-provenance(); }
                        }
                        if !root.info.provenance.removed: Link {
                            text: "Edit rule";
                            clicked => { root.edit-shown-rule(); }
                        }
                        if root.info.provenance.move-back != "": Link {
                            text: "Move back";
                            clicked => { root.move-back(); }
                        }
                        if !root.info.provenance.removed: Link {
                            text: "Why?";
                            clicked => { root.toggle-why(); }
                        }
                    }
                }
                if root.info.provenance.open: VerticalLayout {
                    padding-left: Theme.pad * 3 / 2;
                    for line in root.info.provenance.all: Text {
                        text: line;
                        font-size: Theme.small-size;
                        color: Theme.pane.secondary;
                    }
                }
                if root.info.provenance.why-open: VerticalLayout {
                    padding-left: Theme.pad * 3 / 2;
                    if root.info.provenance.why.length == 0: Text {
                        text: "The rule's conditions could not be checked.";
                        font-size: Theme.small-size;
                        color: Theme.pane.muted;
                    }
                    for line in root.info.provenance.why: Text {
                        text: (line.met ? "Met: " : "Not met: ") + line.text;
                        font-size: Theme.small-size;
                        color: line.met ? Theme.pane.success : Theme.pane.muted;
                    }
                    Text {
                        text: "Checked against the rule as it reads now.";
                        font-size: Theme.small-size;
                        color: Theme.pane.muted;
                    }
                }
            }
            if root.info.attachments.length > 0: FlexboxLayout {
                spacing: Theme.pad;
                for attachment[i] in root.info.attachments: AttachmentChip {
                    attachment: attachment;
                    file-icon: root.file-icon;
                    save-icon: root.save-icon;
                    pending: root.info.attachments-pending;
                    save => { root.save-attachment(i); }
                    save-as => { root.save-attachment-as(i); }
                }
            }
            if root.info.saved != "" && !root.info.unsubscribed: Text {
                text: root.info.saved;
                color: Theme.pane.text;
                wrap: word-wrap;
            }
            if root.info.saved != "" && root.info.unsubscribed: HorizontalLayout {
                spacing: Theme.pad;
                Text {
                    text: root.info.saved;
                    color: Theme.pane.text;
                    vertical-alignment: center;
                    wrap: word-wrap;
                }
                TextButton {
                    text: "Delete message";
                    framed: true;
                    palette: Theme.pane;
                    accessible-label: "Delete the unsubscribed message";
                    clicked => { root.trash-unsubscribed(); }
                }
                Rectangle { horizontal-stretch: 1; }
            }

            // More room around the headers' hairline than between them.
            VerticalLayout {
                padding-top: Theme.pad * 5 / 4;
                padding-bottom: Theme.pad * 5 / 4;
                Hairline { }
            }

            if root.info.shows-html: HtmlView {
                vertical-stretch: 1;
                page: root.page;
                strips: root.strips;
                width-changed(width) => { root.page-width(width); }
                shown(top, bottom) => { root.page-visible(top, bottom); }
                hover(x, y) => { root.page-hover(x, y); }
                leave => { root.page-leave(); }
                select(fx, fy, tx, ty) => { root.page-select(fx, fy, tx, ty); }
                clicked(x, y) => { root.page-clicked(x, y); }
                load-remote => { root.load-remote(); }
                forget-remote(domain) => { root.forget-remote(domain); }
                open-link => { root.page-open-link(); }
                copy-link => { root.page-copy-link(); }
            }

            if !root.info.shows-html && root.info.text-note != "": Text {
                text: root.info.text-note;
                color: Theme.pane.muted;
            }

            if !root.info.shows-html: scroll := ScrollView {
                vertical-stretch: 1;
                VerticalLayout {
                    width: scroll.visible-width;
                    alignment: start;
                    spacing: Theme.pad;
                    if root.text == "": Text {
                        text: root.info.missing;
                        color: Theme.pane.muted;
                    }
                    if root.text != "": TextInput {
                        // A comfortable measure, as the canvas sets it.
                        max-width: 80 * Theme.pad;
                        line-height-factor: 1.2;
                        text: root.text;
                        read-only: true;
                        single-line: false;
                        wrap: word-wrap;
                        font-size: Theme.reading-size;
                        color: Theme.pane.text;
                        selection-background-color: Theme.pane.selected;
                        selection-foreground-color: Theme.pane.on-accent;
                        accessible-label: "Message text";
                    }
                    for link in root.info.links: Link {
                        height: Theme.row;
                        text: link;
                        clicked => { root.open-link(link); }
                    }
                }
            }
        }
    }
}
