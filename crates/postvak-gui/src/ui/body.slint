// The body pane: the message actions, then the message's header, attachments, and the text with its links; or, with
// several messages selected, the selection. `body.rs` words it, `toolbar.rs` the actions.
import { ListView, ScrollView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { Heading, IconButton, Link, TextButton } from "common.slint";

// A message action: its glyph, its accessible name, its hover hint and the label it shows beside the glyph while
// several messages are selected.
export struct ToolButton {
    icon: string,
    name: string,
    hint: string,
    label: string,
}

// A selected message, as the selection lists it.
export struct SelectedData {
    who: string,
    subject: string,
    date: string,
    unread: bool,
}

export struct BodyInfo {
    // Instead of a message, when set.
    empty: string,
    subject: string,
    initials: string,
    // Which of `Theme.avatars` the initials sit on.
    tint: int,
    // The sender's logo instead of the initials, when `has-logo`; `logo-key` names it, so it is drawn once.
    logo: image,
    has-logo: bool,
    logo-key: string,
    name: string,
    address: string,
    short-date: string,
    full-date: string,
    to: string,
    cc: string,
    downloaded: bool,
    missing: string,
    has-html: bool,
    shows-html: bool,
    text-note: string,
    attachments: [string],
    saved: string,
    unsubscribe: bool,
    links: [string],
}

export struct StripData {
    image: image,
    y: length,
    width: length,
    height: length,
}

// What the HTML page says about remote content.
export enum Remote { none, not-loaded, loading }

export struct PageInfo {
    // Laid out: the page and its strips can show.
    ready: bool,
    width: length,
    height: length,
    remote: Remote,
    // The link under the pointer, or empty.
    link: string,
}

// The laid-out HTML page as painted strips. Hover asks which link is under the pointer, a drag selects text, a click
// opens a link; every position is in page points.
component HtmlView inherits VerticalLayout {
    in property <PageInfo> page;
    in property <[StripData]> strips;
    callback width-changed(length);
    callback shown(length, length);
    callback hover(length, length);
    callback leave();
    callback select(length, length, length, length);
    callback clicked(length, length);
    callback load-remote();
    callback open-link();
    callback copy-link();

    spacing: Theme.pad;

    if root.page.remote == Remote.loading: Text {
        text: "Loading remote content…";
        color: Theme.pane.muted;
    }
    if root.page.remote == Remote.not-loaded: HorizontalLayout {
        spacing: Theme.pad;
        Text {
            text: "Remote content not loaded.";
            color: Theme.pane.muted;
            overflow: elide;
            vertical-alignment: center;
        }
        TextButton {
            text: "Load remote content";
            framed: true;
            palette: Theme.pane;
            clicked => { root.load-remote(); }
        }
        Rectangle { horizontal-stretch: 1; }
    }
    if !root.page.ready: Text {
        text: "Rendering…";
        color: Theme.pane.muted;
    }

    flick := Flickable {
        vertical-stretch: 1;
        // A drag selects text; the wheel and the scroll bars move the page.
        interactive: false;
        content-width: max(root.page.width, self.width);
        content-height: root.page.height;
        init => {
            root.width-changed(self.width);
            root.shown(-self.content-y, -self.content-y + self.height);
        }
        changed width => { root.width-changed(self.width); }
        changed height => { root.shown(-self.content-y, -self.content-y + self.height); }
        changed content-y => { root.shown(-self.content-y, -self.content-y + self.height); }

        if root.page.ready: Rectangle {
            width: max(root.page.width, flick.width);
            height: root.page.height;
            background: white;
            border-width: 1px;
            border-color: Theme.pane.border;
        }
        for strip in root.strips: Image {
            x: 0;
            y: strip.y;
            width: strip.width;
            height: strip.height;
            source: strip.image;
        }
        touch := TouchArea {
            width: max(root.page.width, flick.width);
            height: root.page.height;
            mouse-cursor: root.page.link != "" ? pointer : text;
            accessible-role: none;
            changed mouse-x => { self.track(); }
            changed mouse-y => { self.track(); }
            changed has-hover => {
                if (!self.has-hover) {
                    root.leave();
                }
            }
            clicked => { root.clicked(self.mouse-x, self.mouse-y); }
            function track() {
                if (self.pressed) {
                    root.select(self.pressed-x, self.pressed-y, self.mouse-x, self.mouse-y);
                } else if (self.has-hover) {
                    root.hover(self.mouse-x, self.mouse-y);
                }
            }
            if root.page.link != "": Tooltip { text: @markdown("\{root.page.link}"); }
        }
        // Above the TouchArea, which takes every button's press before its parent sees it.
        ContextMenuArea {
            width: max(root.page.width, flick.width);
            height: root.page.height;
            Menu {
                MenuItem {
                    title: "Open link";
                    enabled: root.page.link != "";
                    activated => { root.open-link(); }
                }
                MenuItem {
                    title: "Copy link";
                    enabled: root.page.link != "";
                    activated => { root.copy-link(); }
                }
            }
        }
    }
}

// A header line: a muted label, then the value.
component HeaderLine inherits HorizontalLayout {
    in property <string> label;
    in property <string> value;
    height: Theme.row;
    spacing: Theme.pad / 2;
    Text {
        text: root.label;
        color: Theme.pane.muted;
        vertical-alignment: center;
    }
    Text {
        horizontal-stretch: 1;
        text: root.value;
        color: Theme.pane.muted;
        overflow: elide;
        vertical-alignment: center;
    }
}

// The sender's logo cut to a circle, or else their initials on their colour. The software renderer does not clip to
// a rounded rectangle, so the logo's corners are painted over in the reader's background instead.
component Avatar inherits Rectangle {
    in property <BodyInfo> info;
    width: Theme.avatar;
    height: Theme.avatar;
    border-radius: self.width / 2;
    background: root.info.has-logo ? transparent : Theme.avatars[root.info.tint];
    if root.info.has-logo: Image {
        accessible-role: none;
        width: parent.width;
        height: parent.height;
        source: root.info.logo;
        image-fit: cover;
    }
    if root.info.has-logo: Path {
        width: parent.width;
        height: parent.height;
        viewbox-width: 2;
        viewbox-height: 2;
        fill: Theme.pane.background;
        fill-rule: evenodd;
        commands: "M 0 0 L 2 0 L 2 2 L 0 2 Z M 1 0 A 1 1 0 1 0 1 2 A 1 1 0 1 0 1 0 Z";
    }
    if !root.info.has-logo: Text {
        accessible-role: none;
        text: root.info.initials;
        font-size: Theme.text-size;
        font-weight: 600;
        color: Theme.pane.heading;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

// Beside the message actions: Unsubscribe, the Text | HTML switch, Save .eml and View source.
component MessageTools inherits HorizontalLayout {
    in property <BodyInfo> info;
    in property <string> save-icon;
    in property <string> source-icon;
    callback unsubscribe();
    callback toggle-html();
    callback save-eml();
    callback open-source();
    spacing: Theme.pad / 2;
    if root.info.unsubscribe: VerticalLayout {
        alignment: center;
        TextButton {
            text: "Unsubscribe";
            palette: Theme.pane;
            framed: true;
            clicked => { root.unsubscribe(); }
        }
    }
    if root.info.has-html: VerticalLayout {
        alignment: center;
        Rectangle {
            border-radius: Theme.pad;
            background: Theme.pane.panel;
            HorizontalLayout {
                padding: Theme.pad / 4;
                TextButton {
                    text: "Text";
                    palette: Theme.pane;
                    selected: !root.info.shows-html;
                    clicked => {
                        if (root.info.shows-html) {
                            root.toggle-html();
                        }
                    }
                }
                TextButton {
                    text: "HTML";
                    palette: Theme.pane;
                    selected: root.info.shows-html;
                    enabled: root.info.text-note == "";
                    disabled-hint: root.info.text-note;
                    clicked => {
                        if (!root.info.shows-html) {
                            root.toggle-html();
                        }
                    }
                }
            }
        }
    }
    IconButton {
        icon: root.save-icon;
        name: "Save .eml";
        hint: "Save .eml";
        disabled-hint: root.info.missing;
        enabled: root.info.downloaded;
        palette: Theme.pane;
        size: Theme.action;
        glyph-size: Theme.large-icon;
        clicked => { root.save-eml(); }
    }
    IconButton {
        icon: root.source-icon;
        name: "View source";
        hint: "View source";
        disabled-hint: root.info.missing;
        enabled: root.info.downloaded;
        palette: Theme.pane;
        size: Theme.action;
        glyph-size: Theme.large-icon;
        clicked => { root.open-source(); }
    }
}

export component BodyPane inherits Rectangle {
    in property <BodyInfo> info;
    // The cleaned text, or empty while it is missing.
    in property <string> text;
    in property <string> save-icon;
    in property <string> source-icon;
    in property <string> rule-icon;
    in property <[ToolButton]> actions;
    in property <bool> actions-enabled;
    // "3 messages selected" while two or more are, else empty; and those messages.
    in property <string> selection-title;
    in property <[SelectedData]> selection;
    callback action(int);
    callback clear-selection();
    callback toggle-html();
    callback save-eml();
    callback open-source();
    callback unsubscribe();
    callback save-attachment(int);
    callback save-attachment-as(int);
    callback open-link(string);
    // Start a rule for mail from this sender.
    callback rule-from();
    in property <PageInfo> page;
    in property <[StripData]> strips;
    callback page-width(length);
    callback page-visible(length, length);
    callback page-hover(length, length);
    callback page-leave();
    callback page-select(length, length, length, length);
    callback page-clicked(length, length);
    callback load-remote();
    callback page-open-link();
    callback page-copy-link();

    property <bool> several: root.selection-title != "";

    if root.info.empty != "" && !root.several: Text {
        x: Theme.inset;
        y: (root.height - self.height) / 2;
        width: root.width - 2 * Theme.inset;
        text: root.info.empty;
        color: Theme.pane.muted;
        horizontal-alignment: center;
        wrap: word-wrap;
    }

    // Wide margins while there is room for them.
    property <length> margin: root.width > 80 * Theme.pad ? 2 * Theme.inset : Theme.inset;
    // Room for the message actions and `MessageTools` on one line: the tools' labels are measured, their padding and
    // icon buttons added.
    property <length> tools: labels.preferred-width + (root.info.unsubscribe ? 2 * Theme.pad : 0px) + (root.info.has-html ? 3 * Theme.pad : 0px) + 2 * Theme.action + 2 * Theme.pad;
    property <bool> wide: root.width - 2 * root.margin >= root.actions.length * (Theme.action + Theme.pad / 2) + Theme.inset + root.tools;
    labels := Text {
        visible: false;
        accessible-role: none;
        text: (root.info.unsubscribe ? "Unsubscribe" : "") + (root.info.has-html ? "TextHTML" : "");
        font-weight: 600;
    }

    if root.info.empty == "" || root.several: VerticalLayout {
        padding-left: root.margin;
        padding-right: root.margin;
        padding-top: Theme.inset;
        padding-bottom: Theme.inset;
        spacing: Theme.pad;

        // The message actions, then the view's choices on the right; with several messages, labelled. A pane too narrow
        // for all of them cuts the bar off rather than growing.
        Rectangle {
            min-width: 0px;
            height: Theme.action;
            clip: true;
        HorizontalLayout {
            spacing: Theme.pad / 2;
            for button[i] in root.actions: IconButton {
                icon: button.icon;
                name: button.name;
                hint: button.hint;
                label: root.several ? button.label : "";
                enabled: root.actions-enabled;
                palette: Theme.pane;
                size: Theme.action;
                glyph-size: Theme.large-icon;
                clicked => { root.action(i); }
            }
            Rectangle { horizontal-stretch: 1; }
            if !root.several && root.wide: MessageTools {
                info: root.info;
                save-icon: root.save-icon;
                source-icon: root.source-icon;
                unsubscribe => { root.unsubscribe(); }
                toggle-html => { root.toggle-html(); }
                save-eml => { root.save-eml(); }
                open-source => { root.open-source(); }
            }
        }
        }
        // A narrow pane puts them on a line of their own.
        if !root.several && !root.wide: HorizontalLayout {
            MessageTools {
                info: root.info;
                save-icon: root.save-icon;
                source-icon: root.source-icon;
                unsubscribe => { root.unsubscribe(); }
                toggle-html => { root.toggle-html(); }
                save-eml => { root.save-eml(); }
                open-source => { root.open-source(); }
            }
            Rectangle { horizontal-stretch: 1; }
        }

        if root.several: VerticalLayout {
            vertical-stretch: 1;
            padding-top: Theme.inset;
            spacing: Theme.pad;
            Heading {
                text: root.selection-title;
                font-size: Theme.subject-size;
                wrap: word-wrap;
            }
            HorizontalLayout {
                height: Theme.row;
                spacing: Theme.pad / 2;
                Text {
                    text: "Actions apply to all of them.";
                    color: Theme.pane.muted;
                    vertical-alignment: center;
                }
                Link {
                    text: "Clear selection";
                    clicked => { root.clear-selection(); }
                }
                Rectangle { horizontal-stretch: 1; }
            }
            Rectangle { height: Theme.pad; }
            Rectangle {
                height: 1px;
                background: Theme.pane.border;
            }
            ListView {
                vertical-stretch: 1;
                for message in root.selection: Rectangle {
                    height: 2 * Theme.row;
                    HorizontalLayout {
                        spacing: Theme.pad * 3 / 2;
                        Text {
                            width: min(10 * Theme.inset, parent.width / 3);
                            text: message.who;
                            font-weight: 600;
                            color: message.unread ? Theme.pane.strong : Theme.pane.secondary;
                            overflow: elide;
                            vertical-alignment: center;
                        }
                        Text {
                            horizontal-stretch: 1;
                            text: message.subject;
                            color: Theme.pane.secondary;
                            overflow: elide;
                            vertical-alignment: center;
                        }
                        Text {
                            text: message.date;
                            font-size: Theme.small-size;
                            color: Theme.pane.muted;
                            vertical-alignment: center;
                        }
                    }
                    Rectangle {
                        y: parent.height - 1px;
                        height: 1px;
                        background: Theme.pane.border;
                    }
                }
            }
        }

        if !root.several: VerticalLayout {
            vertical-stretch: 1;
            padding-top: Theme.pad;
            spacing: Theme.pad;

            HorizontalLayout {
                spacing: Theme.pad;
                Heading {
                    horizontal-stretch: 1;
                    text: root.info.subject;
                    font-size: Theme.subject-size;
                    wrap: word-wrap;
                }
                if root.info.address != "": VerticalLayout {
                    alignment: start;
                    IconButton {
                        icon: root.rule-icon;
                        name: "New rule for mail from this sender";
                        hint: "New rule for mail from this sender";
                        palette: Theme.pane;
                        clicked => { root.rule-from(); }
                    }
                }
            }

            HorizontalLayout {
                padding-top: Theme.pad;
                padding-bottom: Theme.pad;
                spacing: Theme.pad * 3 / 2;
                VerticalLayout {
                    alignment: start;
                    Avatar { info: root.info; }
                }
                VerticalLayout {
                    alignment: center;
                    HorizontalLayout {
                        height: Theme.row;
                        spacing: Theme.pad;
                        // The address gives way first in a narrow pane.
                        Text {
                            min-width: min(self.preferred-width, 4 * Theme.inset);
                            text: root.info.name;
                            font-weight: 600;
                            color: Theme.pane.strong;
                            overflow: elide;
                            vertical-alignment: center;
                        }
                        if root.info.address != "": Text {
                            text: root.info.address;
                            color: Theme.pane.muted;
                            overflow: elide;
                            vertical-alignment: center;
                        }
                        Rectangle { horizontal-stretch: 1; }
                        TouchArea {
                            width: date.preferred-width;
                            accessible-role: none;
                            Tooltip { text: @markdown("\{root.info.full-date}"); }
                            date := Text {
                                text: root.info.short-date;
                                color: Theme.pane.muted;
                                vertical-alignment: center;
                            }
                        }
                    }
                    if root.info.to != "": HeaderLine {
                        label: "to";
                        value: root.info.to;
                    }
                    if root.info.cc != "": HeaderLine {
                        label: "cc";
                        value: root.info.cc;
                    }
                }
            }
            for attachment[i] in root.info.attachments: HorizontalLayout {
                spacing: Theme.pad;
                Text {
                    text: attachment;
                    color: Theme.pane.text;
                    vertical-alignment: center;
                }
                TextButton {
                    text: "Save";
                    framed: true;
                    palette: Theme.pane;
                    accessible-label: "Save " + attachment;
                    clicked => { root.save-attachment(i); }
                }
                TextButton {
                    text: "Save as…";
                    framed: true;
                    palette: Theme.pane;
                    accessible-label: "Save " + attachment + " as";
                    clicked => { root.save-attachment-as(i); }
                }
                Rectangle { horizontal-stretch: 1; }
            }
            if root.info.saved != "": Text {
                text: root.info.saved;
                color: Theme.pane.text;
                wrap: word-wrap;
            }

            // More room under the headers' hairline than between them.
            VerticalLayout {
                padding-bottom: Theme.pad;
                Rectangle {
                    height: 1px;
                    background: Theme.pane.border;
                }
            }

            if root.info.shows-html: HtmlView {
                vertical-stretch: 1;
                page: root.page;
                strips: root.strips;
                width-changed(width) => { root.page-width(width); }
                shown(top, bottom) => { root.page-visible(top, bottom); }
                hover(x, y) => { root.page-hover(x, y); }
                leave => { root.page-leave(); }
                select(fx, fy, tx, ty) => { root.page-select(fx, fy, tx, ty); }
                clicked(x, y) => { root.page-clicked(x, y); }
                load-remote => { root.load-remote(); }
                open-link => { root.page-open-link(); }
                copy-link => { root.page-copy-link(); }
            }

            if !root.info.shows-html && root.info.text-note != "": Text {
                text: root.info.text-note;
                color: Theme.pane.muted;
            }

            if !root.info.shows-html: scroll := ScrollView {
                vertical-stretch: 1;
                VerticalLayout {
                    width: scroll.visible-width;
                    alignment: start;
                    spacing: Theme.pad;
                    if root.text == "": Text {
                        text: root.info.missing;
                        color: Theme.pane.muted;
                    }
                    if root.text != "": TextInput {
                        text: root.text;
                        read-only: true;
                        single-line: false;
                        wrap: word-wrap;
                        font-size: Theme.reading-size;
                        color: Theme.pane.text;
                        selection-background-color: Theme.pane.selected;
                        selection-foreground-color: Theme.pane.on-accent;
                        accessible-label: "Message text";
                    }
                    for link in root.info.links: Link {
                        height: Theme.row;
                        text: link;
                        clicked => { root.open-link(link); }
                    }
                }
            }
        }
    }
}
