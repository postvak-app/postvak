// Inkt: per mode a pane palette and an ink-blue chrome palette (toolbar, folders, status bar) around it, the
// grid every size comes from (`theme.rs` has the sizes Rust needs; a test keeps them equal), and the bundled fonts.
import "../../assets/fonts/BricolageGrotesque-SemiBold.ttf";
import "../../assets/fonts/HankenGrotesk-Medium.ttf";
import "../../assets/fonts/HankenGrotesk-SemiBold.ttf";
import "../../assets/fonts/Phosphor.ttf";
import "../../assets/fonts/SplineSansMono-Medium.ttf";

import { Palette as StdPalette } from "std-widgets.slint";

export enum ThemePreference { system, light, dark }

export struct Palette {
    accent: color,
    // Behind lines a change adds, as in a diff; `success` marks them.
    added: color,
    background: color,
    border: color,
    error: color,
    faint: color,
    // The reader's subject.
    heading: color,
    highlight: color,
    hover: color,
    muted: color,
    // Text on `selected`.
    on-accent: color,
    panel: color,
    // Behind a widget while it is pressed or dragged; `strong` is drawn on it.
    pressed: color,
    secondary: color,
    // Behind the selected row, folder and text.
    selected: color,
    // Bold text, such as account headings and header labels: more contrast than `text`, and it must also read on
    // `pressed`.
    strong: color,
    success: color,
    text: color,
    warning: color,
}

export global Theme {
    // The user's choice; System follows the desktop's colour scheme.
    in property <ThemePreference> preference;
    // Whether the desktop is dark. The mail window sets std-widgets' scheme to match `dark`, so it learns the desktop's
    // from a `SchemeProbe`; other windows read their own std-widgets scheme, which follows the desktop.
    in property <bool> desktop-dark: StdPalette.color-scheme == ColorScheme.dark;
    out property <bool> dark: preference == ThemePreference.dark || (preference == ThemePreference.system && desktop-dark);
    // The panes.
    out property <Palette> pane: dark ? night : paper;
    // The ink chrome around them: toolbar, folders, status bar.
    out property <Palette> frame: dark ? frame-night : frame-day;

    out property <length> control: 28px;
    // The message actions, the list's filter button and the search field: a little larger than `control`.
    out property <length> action: control + pad;
    out property <length> top-bar: 40px;
    out property <length> row: 24px;
    // A folder in the folder pane.
    out property <length> folder-row: row + pad;
    // A message in the list: the sender and date, the subject and the body's start, a line of 20 each, 10 above and
    // below.
    out property <length> list-row: 10 * pad;
    // A heading strip above a list row: a date group, or "Close matches" in a search.
    out property <length> section: 4 * pad;
    out property <length> pad: 8px;
    out property <length> inset: 2 * pad;
    out property <length> icon: 16px;
    // The glyphs of folders and of `action` buttons.
    out property <length> large-icon: icon + pad / 4;
    // The sender's avatar in the reader.
    out property <length> avatar: 5 * pad;
    out property <length> glyph: (control - icon) / 2;
    out property <length> radius: 10px;
    // Dialog widths, narrowest first: the move picker; the unsaved-changes question; About; the account form and the
    // apply confirmation; the action history; the keys; the message source.
    out property <length> dialog-narrow: 320px;
    out property <length> dialog-small: 360px;
    out property <length> dialog-medium: 420px;
    out property <length> dialog: 480px;
    out property <length> dialog-large: 520px;
    out property <length> dialog-x-large: 560px;
    out property <length> dialog-wide: 720px;
    // The shadow under a dialog, and the dimmed window behind it.
    out property <color> shadow: #0006;
    out property <color> scrim: #0005;
    // The one action a screen leads with, in both modes: the website's vermilion, darkened so white text passes AA.
    out property <color> brand: #c4441f;
    out property <color> brand-hover: #a93a1a;
    out property <color> on-brand: #ffffff;
    out property <color> brand-glow: #e8562f66;
    // The website's peach: the glyph of an empty pane.
    out property <color> brand-soft: #f3b39d;
    // The brand's glow behind the top of the folder pane.
    out property <color> frame-glow: dark ? #e8562f24 : #e8562f2e;
    // The dot before each account's heading, in turn: the website's code colours, which read on both frames.
    out property <[color]> account-dots: [#9fb6e6, #e6b85c, #9ccb8f, #f3b39d];
    // How long a hover background takes to fade in or out; selection and presses change at once.
    out property <duration> hover-fade: 90ms;
    // How long a message turning read or unread, or an account's status dot, takes to fade.
    out property <duration> state-fade: 120ms;
    // How long a message that arrives while the window is open takes to fade in.
    out property <duration> arrive-fade: 150ms;
    // How long the sync progress takes to glide from one fetched chunk to the next.
    out property <duration> progress-glide: 240ms;

    // Type sizes: secondary labels, the interface, the message text, pane headings, the list's title, the reader's subject.
    out property <length> small-size: 12px;
    // The reader's actions, pills and rule strip: between the secondary labels and the interface.
    out property <length> compact-size: 12.5px;
    // A proposal card's title, and its dry run's count.
    out property <length> card-title-size: 21px;
    out property <length> count-size: 40px;
    out property <length> text-size: 13px;
    out property <length> reading-size: 15px;
    out property <length> heading-size: 19px;
    out property <length> title-size: 22px;
    out property <length> subject-size: 30px;
    // An empty pane's heading and the line under it.
    out property <length> empty-size: 24px;
    out property <length> lede-size: 14px;
    // The wordmark beside the app icon, and the small capitals of an account heading.
    out property <length> wordmark-size: 20px;
    out property <length> caps-size: 11px;
    out property <string> text-font: "Hanken Grotesk";
    // Headings and the wordmark; only its SemiBold is bundled.
    out property <string> heading-font: "Bricolage Grotesque";
    out property <string> mono-font: "Spline Sans Mono";
    out property <string> icon-font: "Phosphor";

    // Avatar fills, picked per sender by `avatar::tint`; `pane.heading` is drawn on them.
    out property <[color]> avatars: dark ? [#2b3650, #5a2a22, #4f3d1f, #2f3f2a, #263b3d, #3a2f48] : [#dfe1ea, #f5d9d0, #e9dcc0, #d6dfc8, #cfdcdc, #e4d8e6];

    out property <Palette> paper: {
        accent: #b83d1c,
        added: #e6eedb,
        background: #faf7f1,
        border: #dcd6c9,
        error: #a8202e,
        faint: #fffdf9,
        heading: #1c2436,
        highlight: #b83d1c,
        hover: #ebe5d9,
        muted: #646574,
        on-accent: #1c2436,
        panel: #f3eee4,
        pressed: #dcd6c9,
        secondary: #4d5063,
        selected: #dfe1ea,
        strong: #0a0e1b,
        success: #3d6420,
        text: #1c2436,
        warning: #8a5a00,
    };
    out property <Palette> night: {
        accent: #f3b39d,
        added: #18241a,
        background: #16181f,
        border: #2b3042,
        error: #f08a8a,
        // Lifted above `background`, as the website's dark cards are.
        faint: #1d2029,
        heading: #f3eee4,
        highlight: #f08a68,
        hover: #20242f,
        muted: #9b9aa4,
        on-accent: #f3eee4,
        panel: #1d2029,
        pressed: #2b3042,
        secondary: #c3c4cf,
        selected: #2b3650,
        strong: #ffffff,
        success: #a9c98a,
        text: #e9e5dc,
        warning: #e6b85c,
    };
    out property <Palette> frame-day: {
        accent: #f08a68,
        added: #18241a,
        background: #1c2436,
        border: #2b3650,
        error: #ffb4a8,
        faint: #273049,
        heading: #f3eee4,
        highlight: #f08a68,
        hover: #253050,
        muted: #a8adbd,
        on-accent: #ffffff,
        panel: #1c2436,
        pressed: #34405e,
        secondary: #cfd3df,
        selected: #2b3650,
        strong: #ffffff,
        success: #a9c98a,
        text: #f3eee4,
        warning: #f2cc7a,
    };
    out property <Palette> frame-night: {
        accent: #f08a68,
        added: #18241a,
        background: #0f121c,
        border: #222a3b,
        error: #ffb4a8,
        faint: #1a2030,
        heading: #f3eee4,
        highlight: #f08a68,
        hover: #1a2030,
        muted: #9ba0b3,
        on-accent: #ffffff,
        panel: #0f121c,
        pressed: #2b3650,
        secondary: #cfd3df,
        selected: #222b40,
        strong: #ffffff,
        success: #a9c98a,
        text: #f3eee4,
        warning: #f2cc7a,
    };
}

// Never shown: its std-widgets scheme is left alone, so it follows the desktop's, which the mail window cannot read
// once it has set its own.
export component SchemeProbe inherits Window {
    out property <bool> dark: StdPalette.color-scheme == ColorScheme.dark;
    callback dark-changed(bool);
    changed dark => { root.dark-changed(self.dark); }
}
