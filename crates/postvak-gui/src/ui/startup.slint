// The small window shown in place of the mail window when that cannot start (`startup.rs` words it).
import { ScrollView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { Heading, Link, TextButton } from "common.slint";
import { AccountFields, AccountForm } from "account.slint";

export component StartupWindow inherits Window {
    in property <string> summary;
    in property <string> fix;
    in property <string> detail;
    in property <string> link-label;
    in property <string> link-url;
    callback open-url(string);
    callback close-clicked();
    // With paths to save under and no account yet: the add-account form in place of the fix.
    in property <bool> form;
    in property <string> account-error;
    in property <bool> account-saving;
    callback save-account(AccountFields);

    title: "Postvak";
    icon: @image-url("../../assets/icon.png");
    preferred-width: 520px;
    preferred-height: root.form ? 460px : 260px;
    background: Theme.pane.background;
    default-font-family: Theme.text-font;
    default-font-size: Theme.text-size;

    VerticalLayout {
        padding: Theme.inset;
        spacing: Theme.pad;
        Heading {
            text: root.summary;
            wrap: word-wrap;
        }
        if !root.form: Text {
            text: root.fix;
            color: Theme.pane.text;
            wrap: word-wrap;
        }
        if root.form: AccountForm {
            error: root.account-error;
            saving: root.account-saving;
            save(fields) => { root.save-account(fields); }
        }
        if root.link-url != "": Link {
            text: root.link-label;
            clicked => { root.open-url(root.link-url); }
        }
        if root.detail != "": ScrollView {
            vertical-stretch: 1;
            Text {
                width: parent.visible-width;
                text: root.detail;
                color: Theme.pane.error;
                wrap: word-wrap;
            }
        }
        if root.detail == "": Rectangle { vertical-stretch: 1; }
        HorizontalLayout {
            alignment: start;
            TextButton {
                text: "Close";
                framed: true;
                palette: Theme.pane;
                clicked => { root.close-clicked(); }
            }
        }
    }
}
