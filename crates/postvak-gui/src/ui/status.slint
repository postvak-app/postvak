// The foot of the folder pane: the sync line that matters most, the sync button and the update link. `status.rs` picks
// and words the line.
import { Theme } from "theme.slint";
import { IconButton, TextButton } from "common.slint";

export enum Dot { none, failed, up-to-date, offline }

export struct StatusLine {
    // "All synced", "Syncing…", "Offline", "Sync failed", or empty while the accounts start.
    headline: string,
    // Some account's sync thread is at work: the dot pulses.
    syncing: bool,
    text: string,
    dot: Dot,
    failed: bool,
    // 0 to 1 while headers or bodies are fetched, else below 0.
    progress: float,
}

// A hairline under the status text while headers or bodies come in: vermilion on the chrome's border colour, gliding
// between chunks. It fades out holding its last value, and a new fetch starts from its own value without rewinding.
component Meter inherits Rectangle {
    // 0 to 1, or below 0 when nothing is fetched.
    in property <float> progress;
    property <bool> active: root.progress >= 0;
    property <float> shown: max(root.progress, 0);
    // False while the fill jumps back for a new fetch.
    property <bool> glide: true;
    changed progress => {
        if root.progress >= 0 {
            root.glide = root.progress >= root.shown;
            root.shown = root.progress;
        }
    }

    height: 3px;
    border-radius: self.height / 2;
    background: Theme.frame.border;
    opacity: root.active ? 1 : 0;
    animate opacity {
        duration: Theme.state-fade;
        easing: ease-out;
    }

    Rectangle {
        x: 0;
        // At least a dot, so a fetch that has just begun shows.
        width: max(parent.height, parent.width * min(root.shown, 1));
        height: parent.height;
        border-radius: parent.border-radius;
        background: @linear-gradient(90deg, Theme.frame.highlight.transparentize(45%) 0%, Theme.frame.highlight 100%);
        animate width {
            duration: root.glide ? Theme.progress-glide : 0ms;
            easing: ease-out;
        }
    }

    // For screen readers, only while a fetch runs.
    if root.active: Rectangle {
        accessible-role: progress-indicator;
        accessible-value: round(root.progress * 100) + "%";
        accessible-value-minimum: 0;
        accessible-value-maximum: 100;
        accessible-value-step: 1;
    }
}

export component StatusBar inherits VerticalLayout {
    in property <StatusLine> line;
    // Every account's line, on hover.
    in property <string> detail;
    in property <string> sync-icon;
    in property <string> sync-hint;
    // "↑ v1.2.3 available", or empty.
    in property <string> update;
    callback sync();
    callback toggle-history();
    callback open-update();

    padding-left: Theme.pad;
    padding-right: Theme.pad;
    padding-bottom: Theme.pad / 2;
    spacing: Theme.pad / 2;

    // A card on the frame: the headline beside its dot, the line under it, the sync button at the end.
    Rectangle {
        border-radius: Theme.pad;
        background: Theme.frame.faint;
        HorizontalLayout {
            padding-left: 5 * Theme.pad / 4;
            padding-right: Theme.pad / 2;
            padding-top: Theme.pad;
            padding-bottom: Theme.pad;
            spacing: Theme.pad / 2;
            TouchArea {
                horizontal-stretch: 1;
                clicked => { root.toggle-history(); }
                accessible-role: button;
                accessible-label: root.line.text;
                accessible-description: root.detail;
                accessible-action-default => { root.toggle-history(); }
                Tooltip { text: @markdown("\{root.detail}"); }
                // Under the text, in the card's padding, so the lines do not move when a fetch starts.
                Meter {
                    y: parent.height + Theme.pad / 4;
                    width: parent.width;
                    progress: root.line.progress;
                }
                VerticalLayout {
                    alignment: center;
                    spacing: Theme.pad / 4;
                    HorizontalLayout {
                        spacing: 3 * Theme.pad / 4;
                        Rectangle {
                            width: 7px;
                            height: self.width;
                            y: (parent.height - self.height) / 2;
                            border-radius: self.width / 2;
                            // Green once up to date, pulsing while a sync runs, quiet when offline; only a failure
                            // gets a ring.
                            border-width: root.line.dot == Dot.failed ? 1.5px : 0px;
                            border-color: Theme.frame.error;
                            background: root.line.dot == Dot.up-to-date ? Theme.frame.success : root.line.dot == Dot.offline ? Theme.frame.muted : root.line.syncing ? Theme.frame.accent : Theme.frame.accent.transparentize(100%);
                            opacity: root.line.syncing && root.line.dot != Dot.failed ? Theme.pulse : 1;
                            animate background, border-color, border-width {
                                duration: Theme.state-fade;
                                easing: ease-out;
                            }
                        }
                        Text {
                            accessible-role: none;
                            horizontal-stretch: 1;
                            text: root.line.headline != "" ? root.line.headline : root.line.text;
                            font-size: Theme.small-size;
                            font-weight: root.line.headline != "" ? 600 : 500;
                            color: root.line.failed ? Theme.frame.error : root.line.headline != "" ? Theme.frame.heading : Theme.frame.muted;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                    }
                    if root.line.headline != "": Text {
                        accessible-role: none;
                        text: root.line.text;
                        font-size: Theme.caps-size;
                        color: root.line.failed ? Theme.frame.error : Theme.frame.muted;
                        animate color {
                            duration: Theme.state-fade;
                            easing: ease-out;
                        }
                        overflow: elide;
                    }
                }
            }
            VerticalLayout {
                alignment: center;
                IconButton {
                    icon: root.sync-icon;
                    name: "Sync now";
                    hint: root.sync-hint;
                    clicked => { root.sync(); }
                }
            }
        }
    }

    if root.update != "": HorizontalLayout {
        TextButton {
            text: root.update;
            text-color: Theme.frame.highlight;
            clicked => { root.open-update(); }
        }
        Rectangle { horizontal-stretch: 1; }
    }
}
