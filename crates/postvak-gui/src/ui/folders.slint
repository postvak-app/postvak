// The folder pane on the frame: All inboxes, each account with its folders, and Rules, Activity and Backups pinned at
// the bottom. `folders.rs` decides what is in it.
import { ScrollView, Spinner } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { HoverFill } from "common.slint";

export enum FolderKind { folder, account, separator }

export struct MenuChoice {
    title: string,
    enabled: bool,
}

export struct FolderItem {
    kind: FolderKind,
    icon: string,
    label: string,
    // The grouped unread count, or empty.
    count: string,
    // The accessible name: "Inbox (2)".
    name: string,
    depth: int,
    selected: bool,
    // "Collapse Projects" on a parent row, else empty.
    caret-name: string,
    // A folder rows can be dropped on.
    droppable: bool,
    // On the line of the list's title: All inboxes, or an account's name, as a heading row.
    heading: bool,
    // An account after the first, with space above it.
    gap: bool,
    // An account heading: syncing, and its store error.
    busy: bool,
    error: string,
    // The right-click menu: the items above the separator, then those below.
    menu-head: [MenuChoice],
    menu-tail: [MenuChoice],
}

// A row that opens a view: indent, icon, label, and the count on the right.
component FolderRow inherits Rectangle {
    in property <FolderItem> item;
    callback clicked();
    callback caret-clicked();
    // The row a drag carries, or -1 for anything else.
    pure callback dragged-row(data-transfer) -> int;
    callback dropped(int);

    property <length> indent: item.depth * Theme.inset;

    height: Theme.row;
    border-radius: Theme.pad / 2;
    background: item.selected ? Theme.frame.selected : transparent;
    accessible-role: list-item;
    accessible-label: item.name;
    accessible-item-selected: item.selected;
    accessible-action-default => { root.clicked(); }

    HoverFill {
        visible: !item.selected;
        hovered: touch.has-hover;
        fill: Theme.frame.hover;
    }

    // The folder a drop would move the rows to: outlined in brass, so it does not read as the selection.
    if drop.has-drag: Rectangle {
        border-radius: root.border-radius;
        border-width: 2px;
        border-color: Theme.frame.highlight;
        background: Theme.frame.highlight.transparentize(80%);
    }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }

    // The open folder holds the rows already.
    drop := DropArea {
        enabled: item.droppable && !item.selected;
        can-drop(event) => {
            root.dragged-row(event.data) >= 0 ? DragAction.move : DragAction.none
        }
        dropped(event) => {
            root.dropped(root.dragged-row(event.data));
            event.proposed-action
        }
    }

    HorizontalLayout {
        padding-left: Theme.pad + root.indent;
        padding-right: Theme.pad;
        spacing: Theme.pad;
        Text {
            accessible-role: none;
            width: Theme.icon;
            text: item.icon;
            font-family: Theme.icon-font;
            font-size: Theme.text-size;
            color: item.selected ? Theme.frame.highlight : Theme.frame.text;
            vertical-alignment: center;
        }
        Text {
            accessible-role: none;
            horizontal-stretch: 1;
            text: item.label;
            color: Theme.frame.text;
            overflow: elide;
            vertical-alignment: center;
        }
        if item.count != "": Text {
            accessible-role: none;
            text: item.count;
            color: item.selected ? Theme.frame.text : Theme.frame.muted;
            vertical-alignment: center;
        }
    }

    if item.caret-name != "": TouchArea {
        x: 0;
        width: root.indent + 2 * Theme.pad + Theme.icon;
        accessible-role: button;
        accessible-label: item.caret-name;
        accessible-action-default => { root.caret-clicked(); }
        clicked => { root.caret-clicked(); }
    }
}

export component FolderPane inherits Rectangle {
    in property <[FolderItem]> items;
    in property <[FolderItem]> pinned;
    callback clicked(int);
    callback caret-clicked(int);
    pure callback dragged-row(data-transfer) -> int;
    // A list row dropped on a folder: the folder, the row.
    callback dropped(int, int);
    // A folder's menu item: the folder, the item's group, its place in the group.
    callback menu(int, int, int);
    callback pinned-clicked(int);

    VerticalLayout {
        ScrollView {
            vertical-stretch: 1;
            VerticalLayout {
                alignment: start;
                padding-top: Theme.pad;
                padding-left: Theme.pad;
                padding-right: Theme.pad;
                spacing: Theme.pad / 2;
                for item[i] in root.items: VerticalLayout {
                    // Space, not a line: the account headings already group the folders.
                    if item.kind == FolderKind.separator: Rectangle { height: Theme.pad; }
                    if item.kind == FolderKind.account: VerticalLayout {
                        padding-top: item.gap ? Theme.row - Theme.pad / 2 : 0px;
                        HorizontalLayout {
                            height: Theme.control;
                            padding-left: Theme.pad;
                            spacing: Theme.pad;
                            Text {
                                text: item.label;
                                color: Theme.frame.muted;
                                vertical-alignment: center;
                            }
                            if item.busy: Spinner {
                                width: Theme.icon * 3 / 4;
                                height: Theme.icon * 3 / 4;
                                y: (parent.height - self.height) / 2;
                                indeterminate: true;
                            }
                            Rectangle { horizontal-stretch: 1; }
                        }
                        if item.error != "": HorizontalLayout {
                            padding-left: Theme.pad;
                            padding-right: Theme.pad;
                            Text {
                                text: item.error;
                                color: Theme.frame.error;
                                wrap: word-wrap;
                            }
                        }
                    }
                    // The menu sits above the row: a TouchArea takes every button's press before its parent sees it.
                    if item.kind == FolderKind.folder: Rectangle {
                        height: item.heading ? Theme.control : Theme.row;
                        FolderRow {
                            y: (parent.height - self.height) / 2;
                            width: parent.width;
                            item: item;
                            clicked => { root.clicked(i); }
                            caret-clicked => { root.caret-clicked(i); }
                            dragged-row(data) => { root.dragged-row(data) }
                            dropped(row) => { root.dropped(i, row); }
                        }
                        ContextMenuArea {
                            Menu {
                                for choice[j] in item.menu-head: MenuItem {
                                    title: choice.title;
                                    enabled: choice.enabled;
                                    activated => { root.menu(i, 0, j); }
                                }
                                MenuSeparator { }
                                for choice[j] in item.menu-tail: MenuItem {
                                    title: choice.title;
                                    enabled: choice.enabled;
                                    activated => { root.menu(i, 1, j); }
                                }
                            }
                        }
                    }
                }
            }
        }

        VerticalLayout {
            padding: Theme.pad;
            spacing: Theme.pad / 2;
            VerticalLayout {
                padding-bottom: Theme.pad / 2;
                Rectangle {
                    height: 1px;
                    background: Theme.frame.border;
                }
            }
            for item[i] in root.pinned: FolderRow {
                item: item;
                clicked => { root.pinned-clicked(i); }
            }
        }
    }
}
