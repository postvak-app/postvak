// The Rules, Activity and Backups views, in place of the list and the body. `rules.rs` words them.
import { ScrollView, StandardTableView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { Heading, Note, Switch, TextButton } from "common.slint";
import { RuleEditor, RuleEditorPane } from "rule_editor.slint";

export enum Sheet { rules, activity, backups }

export struct ProposalData {
    label: string,
    by: string,
    summary: string,
    toml: string,
    // A "+" for each line of `toml`.
    marks: string,
    preview: string,
}

export struct RuleData {
    label: string,
    enabled: bool,
    scope: string,
    by: string,
    summary: string,
    // Open in the editor.
    selected: bool,
}

// What a rule matches and what it does, in one line.
component Summary inherits Text {
    // The mono font has no "→"; this one does, so the arrow looks the same on every system.
    font-family: Theme.text-font;
    font-size: Theme.small-size;
    color: Theme.pane.secondary;
    wrap: word-wrap;
}

// A small rounded label, such as "work · INBOX" or "proposed by agent".
component Chip inherits Rectangle {
    in property <string> text;
    in property <color> tint: Theme.pane.muted;
    height: Theme.row - Theme.pad / 2;
    width: label.preferred-width + Theme.pad;
    border-radius: Theme.pad;
    border-width: 1px;
    border-color: root.tint;
    label := Text {
        text: root.text;
        color: root.tint;
        font-size: Theme.small-size;
        vertical-alignment: center;
    }
}

export component RulesPane inherits Rectangle {
    in property <Sheet> sheet;
    // Rules.
    in property <string> banner;
    // "Trust mx.google.com for work", one button each.
    in property <[string]> offers;
    // "1 rule · 2 proposals".
    in property <string> counts;
    in property <[ProposalData]> proposals;
    in property <[RuleData]> rules;
    // Activity and Backups.
    in property <[TableColumn]> columns;
    in property <[[StandardListViewItem]]> cells;
    in property <string> empty;
    in property <string> purge-hint;
    in property <string> close-icon;
    // The chosen row of Backups, or -1.
    in-out property <int> current-row: -1;
    callback open-rules-file();
    callback new-rule();
    callback edit-rule(int);
    callback approve(int);
    callback trust(int);
    callback reject(int);
    callback preview(int);
    callback set-enabled(int, bool);
    callback apply-rule(int);
    callback restore(int);
    callback purge();
    callback sort(int, bool);

    // The title row starts where the list's and the reader's do.
    VerticalLayout {
        padding: Theme.inset;
        padding-top: Theme.pad;
        spacing: Theme.pad;

        if root.sheet == Sheet.rules && root.banner != "": Text {
            text: root.banner;
            color: Theme.pane.error;
            wrap: word-wrap;
        }
        if root.sheet == Sheet.rules && root.offers.length > 0: VerticalLayout {
            spacing: Theme.pad;
            for offer[i] in root.offers: HorizontalLayout {
                TextButton {
                    text: offer;
                    framed: true;
                    palette: Theme.pane;
                    hint: "Adds the server to the account's trusted_authserv_ids in config.toml";
                    clicked => { root.trust(i); }
                }
                Rectangle { horizontal-stretch: 1; }
            }
        }
        // The sheet's title, with its action at the end.
        HorizontalLayout {
            height: Theme.control;
            spacing: Theme.pad;
            Heading {
                text: root.sheet == Sheet.rules ? "Rules" : root.sheet == Sheet.activity ? "Activity" : "Backups";
                vertical-alignment: center;
            }
            if root.sheet == Sheet.rules: Text {
                text: root.counts;
                color: Theme.pane.muted;
                vertical-alignment: center;
            }
            Rectangle { horizontal-stretch: 1; }
            if root.sheet == Sheet.rules: HorizontalLayout {
                alignment: end;
                spacing: Theme.pad;
                VerticalLayout {
                    alignment: center;
                    TextButton {
                        text: "Open rules.toml";
                        palette: Theme.pane;
                        clicked => { root.open-rules-file(); }
                    }
                }
                VerticalLayout {
                    alignment: center;
                    TextButton {
                        text: "New rule";
                        framed: true;
                        palette: Theme.pane;
                        clicked => { root.new-rule(); }
                    }
                }
            }
            if root.sheet == Sheet.backups && root.cells.length > 0: VerticalLayout {
                alignment: center;
                TextButton {
                    text: "Purge";
                    framed: true;
                    palette: Theme.pane;
                    hint: root.purge-hint;
                    clicked => { root.purge(); }
                }
            }
            if root.sheet == Sheet.backups && root.cells.length > 0: VerticalLayout {
                alignment: center;
                TextButton {
                    text: "Restore";
                    framed: true;
                    palette: Theme.pane;
                    enabled: root.current-row >= 0;
                    disabled-hint: "Choose a backup first";
                    clicked => { root.restore(root.current-row); }
                }
            }
        }

        if root.sheet != Sheet.rules && root.cells.length == 0: Text {
            text: root.empty;
            color: Theme.pane.muted;
            wrap: word-wrap;
        }

        // It takes the keyboard, so Up and Down choose a backup to restore; other keys reach the window.
        if root.sheet != Sheet.rules && root.cells.length > 0: StandardTableView {
            init => { self.focus(); }
            columns: root.columns;
            rows: root.cells;
            current-row <=> root.current-row;
            sort-ascending(column) => { root.sort(column, true); }
            sort-descending(column) => { root.sort(column, false); }
        }

        if root.sheet == Sheet.rules: HorizontalLayout {
            vertical-stretch: 1;
            spacing: Theme.inset;
            ScrollView {
                width: 460px;
                VerticalLayout {
                    alignment: start;
                    spacing: Theme.pad;

                    for proposal[i] in root.proposals: Rectangle {
                        border-width: 1px;
                        border-color: Theme.pane.border;
                        border-radius: Theme.pad;
                        VerticalLayout {
                            padding: Theme.pad;
                            spacing: Theme.pad / 2;
                            HorizontalLayout {
                                spacing: Theme.pad;
                                Text {
                                    text: proposal.label;
                                    font-weight: 600;
                                    color: Theme.pane.strong;
                                    overflow: elide;
                                    vertical-alignment: center;
                                }
                                VerticalLayout {
                                    alignment: center;
                                    Chip {
                                        text: proposal.by;
                                        tint: Theme.pane.warning;
                                    }
                                }
                                Rectangle { horizontal-stretch: 1; }
                            }
                            Summary { text: proposal.summary; }
                            Note { text: "Adds to rules.toml"; }
                            // Every line is added, so each gets a diff's "+" and tint.
                            Rectangle {
                                background: Theme.pane.added;
                                border-radius: Theme.pad / 2;
                                // The marks and the lines share font and size, so each "+" sits beside its line.
                                HorizontalLayout {
                                    padding: Theme.pad / 2;
                                    padding-left: Theme.pad;
                                    spacing: Theme.pad;
                                    Text {
                                        accessible-role: none;
                                        text: proposal.marks;
                                        font-family: Theme.mono-font;
                                        font-size: Theme.small-size;
                                        color: Theme.pane.success;
                                    }
                                    Text {
                                        horizontal-stretch: 1;
                                        text: proposal.toml;
                                        font-family: Theme.mono-font;
                                        font-size: Theme.small-size;
                                        color: Theme.pane.text;
                                    }
                                }
                            }
                            HorizontalLayout {
                                spacing: Theme.pad / 2;
                                TextButton {
                                    text: "Approve";
                                    framed: true;
                                    palette: Theme.pane;
                                    clicked => { root.approve(i); }
                                }
                                TextButton {
                                    text: "Reject";
                                    framed: true;
                                    palette: Theme.pane;
                                    clicked => { root.reject(i); }
                                }
                                TextButton {
                                    text: "Preview on cached mail";
                                    palette: Theme.pane;
                                    hint: "Counts what it would do to the mail already downloaded; changes nothing";
                                    clicked => { root.preview(i); }
                                }
                                Rectangle { horizontal-stretch: 1; }
                            }
                            if proposal.preview != "": Text {
                                text: proposal.preview;
                                color: Theme.pane.secondary;
                                wrap: word-wrap;
                            }
                        }
                    }

                    if root.rules.length == 0: Text {
                        text: "rules.toml has no rules yet.";
                        color: Theme.pane.muted;
                    }
                    for rule[i] in root.rules: Rectangle {
                        border-radius: Theme.pad / 2;
                        background: rule.selected ? Theme.pane.selected : mod(i, 2) == 0 ? Theme.pane.panel : transparent;
                        HorizontalLayout {
                            padding: Theme.pad;
                            spacing: Theme.pad;
                            VerticalLayout {
                                alignment: start;
                                Switch {
                                    name: "Enable " + rule.label;
                                    checked: rule.enabled;
                                    toggled(on) => { root.set-enabled(i, on); }
                                }
                            }
                            VerticalLayout {
                                spacing: Theme.pad / 2;
                                HorizontalLayout {
                                    spacing: Theme.pad;
                                    TouchArea {
                                        width: name.preferred-width;
                                        mouse-cursor: pointer;
                                        accessible-role: button;
                                        accessible-label: rule.label;
                                        accessible-description: "Open in the editor";
                                        accessible-action-default => { root.edit-rule(i); }
                                        clicked => { root.edit-rule(i); }
                                        name := Text {
                                            accessible-role: none;
                                            text: rule.label;
                                            font-weight: 600;
                                            color: Theme.pane.strong;
                                            overflow: elide;
                                            vertical-alignment: center;
                                        }
                                    }
                                    VerticalLayout {
                                        alignment: center;
                                        Chip { text: rule.scope; }
                                    }
                                    if rule.by != "": VerticalLayout {
                                        alignment: center;
                                        Chip {
                                            text: rule.by;
                                            tint: Theme.pane.warning;
                                        }
                                    }
                                    Rectangle { horizontal-stretch: 1; }
                                }
                                Summary { text: rule.summary; }
                                HorizontalLayout {
                                    TextButton {
                                        text: "Apply to existing mail";
                                        flush: true;
                                        palette: Theme.pane;
                                        enabled: rule.enabled;
                                        hint: "Runs this rule's actions, which may delete mail, on the mail its accounts already hold, now";
                                        disabled-hint: "Turn the rule on first";
                                        clicked => { root.apply-rule(i); }
                                    }
                                    Rectangle { horizontal-stretch: 1; }
                                }
                            }
                        }
                    }
                    Note { text: "Rules run top to bottom on every sync, only on mail that arrives after they are enabled."; }
                }
            }
            if RuleEditor.open: RuleEditorPane {
                horizontal-stretch: 1;
                close-icon: root.close-icon;
            }
            if !RuleEditor.open: Text {
                horizontal-stretch: 1;
                text: "Choose a rule to edit it, or start a New rule.";
                color: Theme.pane.muted;
                wrap: word-wrap;
            }
        }
    }
}
