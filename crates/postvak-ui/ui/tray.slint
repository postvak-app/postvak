// The tray icon: it keeps Postvak running with the window closed, while the desktop shows it.
export component Tray inherits SystemTrayIcon {
    in property <string> hint;
    callback open();
    callback sync();
    callback quit();

    // macOS draws the title beside the icon in the menu bar, so there it shows only a glyph the menu bar tints.
    icon: Platform.os != OperatingSystemType.macos ? @image-url("../assets/icon.png") : @image-url("../assets/tray.png");
    tooltip: root.hint;
    title: Platform.os == OperatingSystemType.macos ? "" : "Postvak";
    clicked => { root.open(); }

    Menu {
        MenuItem {
            title: "Open Postvak";
            activated => { root.open(); }
        }
        MenuItem {
            title: "Sync now";
            activated => { root.sync(); }
        }
        MenuSeparator { }
        MenuItem {
            title: "Quit";
            activated => { root.quit(); }
        }
    }
}
