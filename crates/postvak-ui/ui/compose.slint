// The composer: a reply or forward above the original in the reader pane, or new mail in `ComposeWindow`. `compose.rs`
// holds and words what it shows.
import { CheckBox, Palette as StdPalette, ScrollView, TextEdit } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { Hairline, IconButton, Note, Switch, TextButton } from "common.slint";
import { AttachmentData } from "body.slint";
import { Choice, Field } from "rule_editor.slint";
import { Dialog, Scrim } from "dialogs.slint";

// The field an error is about, under which it shows; the same names as `compose::Field`.
export enum ComposeSpot { none, attachments, bcc, cc, from, note, send, subject, to }

// What the user edits as text; the same names as `compose::ComposeField`.
export enum ComposeField { bcc, cc, from, subject, text, to }

// One of a forwarded message's attachments, and whether an inline forward takes it along.
export struct ComposePart {
    name: string,
    size: string,
    kept: bool,
}

export struct ComposeData {
    open: bool,
    // Filled from the original yet, and not on its way: Send is off meanwhile.
    loading: bool,
    sending: bool,
    from: string,
    // Which of the From choices `from` is; -1 when it was typed, so it shows as a field.
    from-index: int,
    to: string,
    cc: string,
    bcc: string,
    show-cc-bcc: bool,
    subject: string,
    text: string,
    forward: bool,
    as-attachment: bool,
    // What is attached out of what the server takes, as "3 KB of 25.0 MB"; empty while nothing is.
    size: string,
    error-at: ComposeSpot,
    error: string,
    // The address field whose completions show, or none; and the highlighted one.
    completing: ComposeSpot,
    completion-index: int,
}

component Error inherits Text {
    color: Theme.pane.error;
    font-size: Theme.small-size;
    wrap: word-wrap;
}

// A field's label, then the field; its error, when it names this field, under it.
component Row inherits VerticalLayout {
    in property <string> label;
    in property <bool> failed;
    in property <string> error;
    spacing: Theme.pad / 2;
    HorizontalLayout {
        spacing: Theme.pad;
        Text {
            accessible-role: none;
            width: 8 * Theme.pad;
            text: root.label;
            color: Theme.pane.muted;
            vertical-alignment: center;
        }
        @children
    }
    if root.failed: Error {
        accessible-label: root.label + ": " + root.error;
        text: root.error;
    }
}

// An address field. While its completions show, Up and Down move through them, Enter or Tab takes one and Esc closes
// them; leaving the field closes them too. It says where it is, so the completions show under it.
component AddressField inherits Field {
    in property <bool> completing;
    in property <int> chosen;
    callback step(int);
    callback pick(int);
    callback dismiss();
    callback placed(/* x */ length, /* bottom */ length, /* width */ length);
    key-pressed(event) => {
        if (!root.completing || event.modifiers.control || event.modifiers.meta || event.modifiers.alt) {
            return reject;
        }
        if (event.text == Key.UpArrow) {
            root.step(-1);
        } else if (event.text == Key.DownArrow) {
            root.step(1);
        } else if (event.text == Key.Return || event.text == Key.Tab) {
            root.pick(root.chosen);
        } else if (event.text == Key.Escape) {
            root.dismiss();
        } else {
            return reject;
        }
        accept
    }
    changed has-focus => {
        if (!self.has-focus) {
            root.dismiss();
        }
    }
    changed completing => {
        if (self.completing) {
            root.placed(self.absolute-position.x, self.absolute-position.y + self.height, self.width);
        }
    }
}

// The composer's state and callbacks; each window has its own, as a global is per window.
export global ComposeState {
    in property <ComposeData> data;
    // From's choices as they read, and the files and the original's parts as they are listed.
    in property <[string]> from-choices;
    in property <[AttachmentData]> files;
    in property <[ComposePart]> parts;
    // The addresses offered under the field being typed in, as `Name <address>`.
    in property <[string]> completions;
    in property <string> send-hint;
    // "Discard this message?" while it asks.
    in property <string> leave-question;
    out property <bool> can-send: !root.data.loading && !root.data.sending;
    // Typing waits for the original's fields, and stops once the message is on its way.
    out property <bool> fixed: !root.can-send;
    callback edited(ComposeField, string);
    callback completion-step(int);
    callback completion-pick(int);
    callback completion-close();
    callback from-chosen(int);
    callback show-cc-bcc();
    callback attach();
    callback remove-file(int);
    callback toggle-part(int);
    callback as-attachment(bool);
    callback send();
    callback close();
    callback discard();
    callback leave-discard();
    callback leave-cancel();
}

export component Composer inherits Rectangle {
    in property <string> remove-icon;

    // Under the field being completed, relative to the composer.
    property <length> completion-x;
    property <length> completion-y;
    property <length> completion-width;
    // Like `Field`, the text is put right by hand when it changes from outside, such as a composer opened again.
    property <string> text: ComposeState.data.text;
    changed text => {
        if (body.text != root.text) {
            body.text = root.text;
        }
    }
    accessible-role: groupbox;
    accessible-label: "Message";
    // A reply starts at the text; a forward, or new mail without a recipient, at To. A reply's To is empty while it loads.
    init => {
        if (ComposeState.data.forward || (!ComposeState.data.loading && ComposeState.data.to == "")) {
            to.focus();
        } else {
            body.focus();
        }
    }

    FocusScope {
        KeyBinding {
            keys: @keys(Control + Return);
            enabled: ComposeState.can-send;
            activated => { ComposeState.send(); }
        }

        VerticalLayout {
            padding: Theme.inset;
            padding-bottom: Theme.pad;
            spacing: Theme.pad;

            HorizontalLayout {
                spacing: Theme.pad;
                TextButton {
                    text: "Send";
                    primary: true;
                    palette: Theme.pane;
                    enabled: ComposeState.can-send;
                    hint: ComposeState.send-hint;
                    disabled-hint: ComposeState.data.sending ? "Sending…" : "Loading the message…";
                    clicked => { ComposeState.send(); }
                }
                TextButton {
                    text: "Close";
                    framed: true;
                    palette: Theme.pane;
                    enabled: !ComposeState.data.sending;
                    clicked => { ComposeState.close(); }
                }
                VerticalLayout {
                    alignment: center;
                    TextButton {
                        text: "Discard";
                        palette: Theme.pane;
                        enabled: !ComposeState.data.sending;
                        clicked => { ComposeState.discard(); }
                    }
                }
                Rectangle { horizontal-stretch: 1; }
                if ComposeState.data.loading: Note {
                    text: "Loading the message…";
                    vertical-alignment: center;
                }
            }
            if ComposeState.data.error-at == ComposeSpot.send: Error { text: ComposeState.data.error; }
            if ComposeState.data.error-at == ComposeSpot.note: Note { text: ComposeState.data.error; }

            Row {
                label: "From";
                failed: ComposeState.data.error-at == ComposeSpot.from;
                error: ComposeState.data.error;
                if ComposeState.data.from-index >= 0: Choice {
                    horizontal-stretch: 1;
                    accessible-label: "From";
                    model: ComposeState.from-choices;
                    index: ComposeState.data.from-index;
                    enabled: !ComposeState.fixed;
                    index-chosen(i) => { ComposeState.from-chosen(i); }
                }
                if ComposeState.data.from-index < 0: Field {
                    horizontal-stretch: 1;
                    accessible-label: "From";
                    read-only: ComposeState.fixed;
                    value: ComposeState.data.from;
                    value-edited(text) => { ComposeState.edited(ComposeField.from, text); }
                }
            }
            Row {
                label: "To";
                failed: ComposeState.data.error-at == ComposeSpot.to;
                error: ComposeState.data.error;
                to := AddressField {
                    horizontal-stretch: 1;
                    accessible-label: "To";
                    read-only: ComposeState.fixed;
                    value: ComposeState.data.to;
                    value-edited(text) => { ComposeState.edited(ComposeField.to, text); }
                    completing: ComposeState.data.completing == ComposeSpot.to && ComposeState.completions.length > 0;
                    chosen: ComposeState.data.completion-index;
                    step(by) => { ComposeState.completion-step(by); }
                    pick(i) => { ComposeState.completion-pick(i); }
                    dismiss => { ComposeState.completion-close(); }
                    placed(x, bottom, width) => {
                        root.completion-x = x - root.absolute-position.x;
                        root.completion-y = bottom - root.absolute-position.y;
                        root.completion-width = width;
                    }
                }
                if !ComposeState.data.show-cc-bcc: TextButton {
                    text: "Cc Bcc";
                    palette: Theme.pane;
                    hint: "Add Cc and Bcc";
                    clicked => { ComposeState.show-cc-bcc(); }
                }
            }
            if ComposeState.data.show-cc-bcc: Row {
                label: "Cc";
                failed: ComposeState.data.error-at == ComposeSpot.cc;
                error: ComposeState.data.error;
                AddressField {
                    horizontal-stretch: 1;
                    accessible-label: "Cc";
                    read-only: ComposeState.fixed;
                    value: ComposeState.data.cc;
                    value-edited(text) => { ComposeState.edited(ComposeField.cc, text); }
                    completing: ComposeState.data.completing == ComposeSpot.cc && ComposeState.completions.length > 0;
                    chosen: ComposeState.data.completion-index;
                    step(by) => { ComposeState.completion-step(by); }
                    pick(i) => { ComposeState.completion-pick(i); }
                    dismiss => { ComposeState.completion-close(); }
                    placed(x, bottom, width) => {
                        root.completion-x = x - root.absolute-position.x;
                        root.completion-y = bottom - root.absolute-position.y;
                        root.completion-width = width;
                    }
                }
            }
            if ComposeState.data.show-cc-bcc: Row {
                label: "Bcc";
                failed: ComposeState.data.error-at == ComposeSpot.bcc;
                error: ComposeState.data.error;
                AddressField {
                    horizontal-stretch: 1;
                    accessible-label: "Bcc";
                    read-only: ComposeState.fixed;
                    value: ComposeState.data.bcc;
                    value-edited(text) => { ComposeState.edited(ComposeField.bcc, text); }
                    completing: ComposeState.data.completing == ComposeSpot.bcc && ComposeState.completions.length > 0;
                    chosen: ComposeState.data.completion-index;
                    step(by) => { ComposeState.completion-step(by); }
                    pick(i) => { ComposeState.completion-pick(i); }
                    dismiss => { ComposeState.completion-close(); }
                    placed(x, bottom, width) => {
                        root.completion-x = x - root.absolute-position.x;
                        root.completion-y = bottom - root.absolute-position.y;
                        root.completion-width = width;
                    }
                }
            }
            Row {
                label: "Subject";
                failed: ComposeState.data.error-at == ComposeSpot.subject;
                error: ComposeState.data.error;
                Field {
                    horizontal-stretch: 1;
                    accessible-label: "Subject";
                    read-only: ComposeState.fixed;
                    value: ComposeState.data.subject;
                    value-edited(text) => { ComposeState.edited(ComposeField.subject, text); }
                }
            }

            body := TextEdit {
                vertical-stretch: 1;
                min-height: 3 * Theme.row;
                wrap: word-wrap;
                accessible-label: "Your text";
                read-only: ComposeState.fixed;
                text: root.text;
                edited(text) => { ComposeState.edited(ComposeField.text, text); }
            }

            HorizontalLayout {
                spacing: Theme.pad;
                TextButton {
                    text: "Attach…";
                    framed: true;
                    palette: Theme.pane;
                    enabled: !ComposeState.data.sending;
                    clicked => { ComposeState.attach(); }
                }
                for file[i] in ComposeState.files: HorizontalLayout {
                    spacing: Theme.pad / 2;
                    Text {
                        text: file.name + " (" + file.size + ")";
                        color: Theme.pane.text;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                    IconButton {
                        icon: root.remove-icon;
                        name: "Remove " + file.name;
                        hint: "Remove this file";
                        palette: Theme.pane;
                        clicked => { ComposeState.remove-file(i); }
                    }
                }
                if ComposeState.data.size != "": Text {
                    text: ComposeState.data.size;
                    color: Theme.pane.muted;
                    vertical-alignment: center;
                }
                Rectangle { horizontal-stretch: 1; }
            }
            if ComposeState.data.error-at == ComposeSpot.attachments: Error { text: ComposeState.data.error; }

            if ComposeState.data.forward: HorizontalLayout {
                spacing: Theme.inset;
                for part[i] in ComposeState.parts: CheckBox {
                    text: part.name + " (" + part.size + ")";
                    checked: part.kept;
                    enabled: !ComposeState.data.as-attachment;
                    toggled => { ComposeState.toggle-part(i); }
                }
                Rectangle { horizontal-stretch: 1; }
                VerticalLayout {
                    alignment: center;
                    Switch {
                        name: "Send as attachment";
                        checked: ComposeState.data.as-attachment;
                        toggled(on) => { ComposeState.as-attachment(on); }
                    }
                }
                Text {
                    accessible-role: none;
                    text: "Send as attachment";
                    color: Theme.pane.text;
                    vertical-alignment: center;
                }
            }
        }
    }
    Hairline {
        y: root.height - self.height;
    }

    // Over the fields below, so it comes last.
    if ComposeState.data.completing != ComposeSpot.none && ComposeState.completions.length > 0: Rectangle {
        x: root.completion-x;
        y: root.completion-y + Theme.pad / 4;
        width: root.completion-width;
        height: choices.preferred-height;
        background: Theme.pane.background;
        border-color: Theme.pane.border;
        border-width: 1px;
        border-radius: Theme.pad;
        drop-shadow-blur: 2 * Theme.pad;
        drop-shadow-offset-y: Theme.pad / 4;
        drop-shadow-color: Theme.shadow;
        accessible-role: list;
        accessible-label: "Addresses";
        // Clicks stay in the list.
        TouchArea { }
        choices := VerticalLayout {
            padding: Theme.pad / 2;
            for choice[i] in ComposeState.completions: Rectangle {
                height: Theme.row;
                border-radius: Theme.pad / 2;
                background: i == ComposeState.data.completion-index ? Theme.pane.selected : touch.has-hover ? Theme.pane.hover : transparent;
                accessible-role: list-item;
                accessible-label: choice;
                accessible-item-selected: i == ComposeState.data.completion-index;
                touch := TouchArea {
                    clicked => { ComposeState.completion-pick(i); }
                }
                Text {
                    accessible-role: none;
                    x: Theme.pad;
                    width: parent.width - 2 * Theme.pad;
                    text: choice;
                    color: i == ComposeState.data.completion-index ? Theme.pane.on-accent : Theme.pane.text;
                    vertical-alignment: center;
                    overflow: elide;
                }
            }
        }
    }
}

// "Discard this message?" before something takes the reader pane from a changed composer.
export component LeaveComposeDialog {
    in property <string> question;
    in property <string> close-icon;
    callback discard();
    callback cancel();
    width: Theme.dialog-small;
    Dialog {
        title: "Unsent message";
        close-icon: root.close-icon;
        close => { root.cancel(); }
        Text {
            text: root.question;
            color: Theme.pane.text;
            wrap: word-wrap;
        }
        HorizontalLayout {
            spacing: Theme.pad;
            Rectangle { horizontal-stretch: 1; }
            TextButton {
                text: "Cancel";
                palette: Theme.pane;
                framed: true;
                clicked => { root.cancel(); }
            }
            TextButton {
                text: "Discard";
                palette: Theme.pane;
                danger: true;
                clicked => { root.discard(); }
            }
        }
    }
}

// New mail in a window of its own, with its own `ComposeState`. Esc closes it, or
// answers its question with Cancel; Ctrl+N (Cmd+N) opens another.
export component ComposeWindow inherits Window {
    in property <string> close-icon;
    callback new-mail();

    property <bool> dark: Theme.dark;
    init => { StdPalette.color-scheme = root.dark ? ColorScheme.dark : ColorScheme.light; }
    changed dark => { StdPalette.color-scheme = root.dark ? ColorScheme.dark : ColorScheme.light; }

    title: ComposeState.data.subject.is-empty ? "New message" : ComposeState.data.subject;
    preferred-width: 720px;
    preferred-height: 640px;
    background: Theme.pane.background;
    default-font-family: Theme.text-font;
    default-font-size: Theme.text-size;
    forward-focus: keys;

    keys := FocusScope {
        key-pressed(event) => {
            if (event.modifiers.control && !event.modifiers.alt && event.text.to-lowercase() == "n") {
                root.new-mail();
                return accept;
            }
            if (event.text != Key.Escape) {
                return reject;
            }
            if (ComposeState.leave-question != "") {
                ComposeState.leave-cancel();
            } else {
                ComposeState.close();
            }
            return accept;
        }
        Composer {
            remove-icon: root.close-icon;
        }
    }

    if ComposeState.leave-question != "": Scrim {
        close => { ComposeState.leave-cancel(); }
    }
    if ComposeState.leave-question != "": LeaveComposeDialog {
        x: (root.width - self.width) / 2;
        y: Theme.inset;
        question: ComposeState.leave-question;
        close-icon: root.close-icon;
        discard => { ComposeState.leave-discard(); }
        cancel => { ComposeState.leave-cancel(); }
    }
}
