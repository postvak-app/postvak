// The toolbar: the wordmark over the folder pane, the message actions over the list, the search button on the right.
import { Theme } from "theme.slint";
import { IconButton } from "common.slint";

export struct ToolButton {
    icon: string,
    name: string,
    hint: string,
}

export component Toolbar inherits Rectangle {
    // The folder pane's width, so the first action's glyph lines up with the list's content.
    in property <length> folders-width;
    in property <[ToolButton]> buttons;
    in property <bool> buttons-enabled;
    in property <bool> search-enabled;
    in property <string> search-icon;
    in property <string> search-hint;
    callback action(int);
    callback search();

    height: Theme.top-bar;

    HorizontalLayout {
        padding-left: Theme.inset;
        padding-right: Theme.inset;
        padding-top: (Theme.top-bar - Theme.control) / 2;
        padding-bottom: (Theme.top-bar - Theme.control) / 2;
        spacing: Theme.pad / 2;

        // As wide as the folder pane, less the gap before the first button and that button's glyph
        // inset, so the glyph lines up with the list's content.
        HorizontalLayout {
            width: max(0px, root.folders-width - Theme.pad / 2 - Theme.glyph);
            spacing: Theme.pad;
            Image {
                width: 20px;
                height: 20px;
                y: (parent.height - self.height) / 2;
                source: @image-url("../../../assets/icon.png");
            }
            Text {
                text: "Postvak";
                font-family: Theme.serif-font;
                font-size: 19px;
                color: Theme.frame.strong;
                vertical-alignment: center;
            }
            Rectangle { horizontal-stretch: 1; }
        }

        for button[i] in root.buttons: IconButton {
            icon: button.icon;
            name: button.name;
            hint: button.hint;
            enabled: root.buttons-enabled;
            clicked => { root.action(i); }
        }

        Rectangle { horizontal-stretch: 1; }

        Rectangle {
            width: 260px;
            border-radius: Theme.pad;
            background: touch.has-hover && root.search-enabled ? Theme.frame.pressed : Theme.frame.faint;
            opacity: root.search-enabled ? 1 : 0.4;
            accessible-role: button;
            accessible-label: "Search";
            accessible-description: root.search-hint;
            accessible-enabled: root.search-enabled;
            accessible-action-default => {
                if (root.search-enabled) {
                    root.search();
                }
            }
            touch := TouchArea {
                enabled: root.search-enabled;
                clicked => { root.search(); }
                Tooltip { text: @markdown("\{root.search-hint}"); }
            }
            HorizontalLayout {
                padding-left: Theme.pad;
                spacing: Theme.pad;
                Text {
                    accessible-role: none;
                    text: root.search-icon;
                    font-family: Theme.icon-font;
                    font-size: Theme.icon;
                    color: Theme.frame.muted;
                    vertical-alignment: center;
                }
                Text {
                    accessible-role: none;
                    text: "Search mail";
                    color: Theme.frame.muted;
                    vertical-alignment: center;
                }
                Rectangle { horizontal-stretch: 1; }
            }
        }
    }
}
