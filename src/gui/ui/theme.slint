// Ossenbloed: per mode a pane palette and an oxblood chrome palette (toolbar, folders, status bar) around it, the
// grid every size comes from (`theme.rs` has the sizes Rust needs; a test keeps them equal), and the bundled fonts.
import "../../../assets/fonts/HankenGrotesk-Medium.ttf";
import "../../../assets/fonts/HankenGrotesk-SemiBold.ttf";
import "../../../assets/fonts/Newsreader-Medium.ttf";
import "../../../assets/fonts/Phosphor.ttf";
import "../../../assets/fonts/SplineSansMono-Medium.ttf";

import { Palette as StdPalette } from "std-widgets.slint";

export enum ThemePreference { system, light, dark }

export struct Palette {
    accent: color,
    background: color,
    border: color,
    error: color,
    faint: color,
    // The reader's subject.
    heading: color,
    highlight: color,
    hover: color,
    muted: color,
    // Text on `selected`.
    on-accent: color,
    panel: color,
    // Behind a widget while it is pressed or dragged; `strong` is drawn on it.
    pressed: color,
    secondary: color,
    // Behind the selected row, folder and text.
    selected: color,
    // Bold text, such as account headings and header labels: more contrast than `text`, and it must also read on
    // `pressed`.
    strong: color,
    text: color,
    warning: color,
}

export global Theme {
    // The user's choice; System follows the desktop's colour scheme.
    in property <ThemePreference> preference;
    out property <bool> dark: preference == ThemePreference.dark || (preference == ThemePreference.system && StdPalette.color-scheme == ColorScheme.dark);
    // The panes.
    out property <Palette> pane: dark ? night : paper;
    // The oxblood chrome around them: toolbar, folders, status bar.
    out property <Palette> frame: dark ? frame-night : frame-day;

    out property <length> control: 28px;
    out property <length> top-bar: 40px;
    out property <length> row: 24px;
    // A message in the list: the sender and date, then the subject.
    out property <length> list-row: 2 * row + pad / 2;
    out property <length> pad: 8px;
    out property <length> inset: 2 * pad;
    out property <length> icon: 16px;
    out property <length> glyph: (control - icon) / 2;
    out property <length> radius: 10px;

    out property <length> text-size: 13px;
    out property <string> text-font: "Hanken Grotesk";
    out property <string> serif-font: "Newsreader";
    out property <string> mono-font: "Spline Sans Mono";
    out property <string> icon-font: "Phosphor";

    out property <Palette> paper: {
        accent: #9a4a1c,
        background: #fbf8f3,
        border: #e3d8cb,
        error: #a8202e,
        faint: #fffdfa,
        heading: #3b1418,
        highlight: #8c6720,
        hover: #eadfd0,
        muted: #6e5958,
        on-accent: #f1e4d8,
        panel: #f3ece2,
        pressed: #e3d8cb,
        secondary: #5e4a4b,
        selected: #3b1418,
        strong: #140b0c,
        text: #2b1a1c,
        warning: #8a5a00,
    };
    out property <Palette> night: {
        accent: #e9c9b0,
        background: #231919,
        border: #3a2b2c,
        error: #f08a8a,
        faint: #140e0f,
        heading: #e9c9b0,
        highlight: #c99a3e,
        hover: #2e2223,
        muted: #b09a93,
        on-accent: #f1e4d8,
        panel: #1a1213,
        pressed: #3a2b2c,
        secondary: #cdb8af,
        selected: #5a1f25,
        strong: #ffffff,
        text: #efe3d6,
        warning: #e6b85c,
    };
    out property <Palette> frame-day: {
        accent: #d9b36a,
        background: #3b1418,
        border: #5a2a2f,
        error: #ffb4a8,
        faint: #4e2629,
        heading: #f1e4d8,
        highlight: #d9b36a,
        hover: #4a1d22,
        muted: #c29a92,
        on-accent: #ffffff,
        panel: #3b1418,
        pressed: #5e2a30,
        secondary: #e0cbbe,
        selected: #552a2b,
        strong: #ffffff,
        text: #f1e4d8,
        warning: #f2cc7a,
    };
    out property <Palette> frame-night: {
        accent: #d9b36a,
        background: #2a0e11,
        border: #4a2226,
        error: #ffb4a8,
        faint: #3b1d20,
        heading: #f1e4d8,
        highlight: #d9b36a,
        hover: #3a171b,
        muted: #c29a92,
        on-accent: #ffffff,
        panel: #2a0e11,
        pressed: #4c2227,
        secondary: #e0cbbe,
        selected: #44262a,
        strong: #ffffff,
        text: #f1e4d8,
        warning: #f2cc7a,
    };
}
