// The Rules, Activity and Backups views, in place of the list and the body. `rules.rs` words them.
import { CheckBox, ScrollView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { TextButton } from "common.slint";

export enum Sheet { rules, activity, backups }

export struct ProposalData {
    title: string,
    toml: string,
}

export struct RuleData {
    label: string,
    enabled: bool,
    scope: string,
    by: string,
}

component Heading inherits Text {
    font-family: Theme.serif-font;
    font-size: 19px;
    color: Theme.pane.heading;
}

// Every other row of a table, `top` below the table's top and as wide as the table.
component Stripes {
    in property <int> rows;
    in property <length> top;
    for r in root.rows: Rectangle {
        x: 0;
        y: root.top + r * Theme.control;
        width: root.width;
        height: Theme.control;
        border-radius: Theme.pad / 2;
        background: mod(r, 2) == 0 ? Theme.pane.panel : transparent;
    }
}

// Rows of cells in columns as wide as their widest cell, striped, with a heading row; `button` adds a button at the
// end of each row.
component Table inherits HorizontalLayout {
    in property <[string]> headings;
    in property <[[string]]> rows;
    in property <string> button;
    callback pressed(int);

    Rectangle {
        width: grid.preferred-width;
        Stripes {
            x: 0;
            y: 0;
            width: parent.width;
            height: parent.height;
            rows: root.rows.length;
            top: Theme.row;
        }
        grid := GridLayout {
            spacing-horizontal: Theme.inset;
            padding-left: Theme.pad;
            padding-right: Theme.pad;
            Row {
                for heading in root.headings: Text {
                    height: Theme.row;
                    text: heading;
                    font-weight: 600;
                    color: Theme.pane.strong;
                    vertical-alignment: center;
                }
            }
            for row[r] in root.rows: Row {
                for cell in row: Text {
                    height: Theme.control;
                    text: cell;
                    color: Theme.pane.text;
                    vertical-alignment: center;
                }
                if root.button != "": VerticalLayout {
                    alignment: center;
                    TextButton {
                        text: root.button;
                        framed: true;
                        palette: Theme.pane;
                        clicked => { root.pressed(r); }
                    }
                }
            }
        }
    }
    Rectangle { horizontal-stretch: 1; }
}

export component RulesPane inherits Rectangle {
    in property <Sheet> sheet;
    // Rules.
    in property <string> banner;
    in property <[ProposalData]> proposals;
    in property <[RuleData]> rules;
    // Activity and Backups.
    in property <[string]> headings;
    in property <[[string]]> cells;
    in property <string> empty;
    callback open-rules-file();
    callback approve(int);
    callback reject(int);
    callback set-enabled(int, bool);
    callback restore(int);

    VerticalLayout {
        padding: Theme.inset;
        spacing: Theme.pad;

        if root.sheet == Sheet.rules && root.banner != "": Text {
            text: root.banner;
            color: Theme.pane.error;
            wrap: word-wrap;
        }
        if root.sheet == Sheet.rules: HorizontalLayout {
            TextButton {
                text: "Open rules.toml";
                framed: true;
                palette: Theme.pane;
                clicked => { root.open-rules-file(); }
            }
            Rectangle { horizontal-stretch: 1; }
        }

        if root.sheet != Sheet.rules && root.cells.length == 0: Text {
            text: root.empty;
            color: Theme.pane.muted;
            wrap: word-wrap;
        }

        ScrollView {
            vertical-stretch: 1;
            VerticalLayout {
                alignment: start;
                spacing: Theme.pad;

                if root.sheet == Sheet.rules && root.proposals.length > 0: Heading { text: "Proposals"; }
                for proposal[i] in root.sheet == Sheet.rules ? root.proposals : []: HorizontalLayout {
                    Rectangle {
                        border-width: 1px;
                        border-color: Theme.pane.border;
                        border-radius: Theme.pad / 2;
                        VerticalLayout {
                            padding: Theme.pad;
                            spacing: Theme.pad / 2;
                            Text {
                                text: proposal.title;
                                font-weight: 600;
                                color: Theme.pane.strong;
                            }
                            Text {
                                text: proposal.toml;
                                font-family: Theme.mono-font;
                                color: Theme.pane.text;
                            }
                            HorizontalLayout {
                                spacing: Theme.pad / 2;
                                TextButton {
                                    text: "Approve";
                                    framed: true;
                                    palette: Theme.pane;
                                    clicked => { root.approve(i); }
                                }
                                TextButton {
                                    text: "Reject";
                                    framed: true;
                                    palette: Theme.pane;
                                    clicked => { root.reject(i); }
                                }
                                Rectangle { horizontal-stretch: 1; }
                            }
                        }
                    }
                    Rectangle { horizontal-stretch: 1; }
                }

                if root.sheet == Sheet.rules: Heading { text: "Rules"; }
                if root.sheet == Sheet.rules && root.rules.length == 0: Text {
                    text: "rules.toml has no rules yet.";
                    color: Theme.pane.muted;
                }
                if root.sheet == Sheet.rules && root.rules.length > 0: HorizontalLayout {
                    Rectangle {
                        width: rule-grid.preferred-width;
                        Stripes {
                            x: 0;
                            y: 0;
                            width: parent.width;
                            height: parent.height;
                            rows: root.rules.length;
                        }
                        rule-grid := GridLayout {
                            spacing-horizontal: Theme.inset;
                            padding-left: Theme.pad;
                            padding-right: Theme.pad;
                            for rule[i] in root.rules: Row {
                                VerticalLayout {
                                    height: Theme.control;
                                    alignment: center;
                                    CheckBox {
                                        text: rule.label;
                                        checked: rule.enabled;
                                        toggled => { root.set-enabled(i, self.checked); }
                                    }
                                }
                                Text {
                                    text: rule.scope;
                                    color: Theme.pane.text;
                                    vertical-alignment: center;
                                }
                                Text {
                                    text: rule.by;
                                    color: Theme.pane.muted;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }
                    Rectangle { horizontal-stretch: 1; }
                }

                if root.sheet == Sheet.activity && root.cells.length > 0: Table {
                    headings: root.headings;
                    rows: root.cells;
                }
                if root.sheet == Sheet.backups && root.cells.length > 0: Table {
                    headings: root.headings;
                    rows: root.cells;
                    button: "Restore";
                    pressed(r) => { root.restore(r); }
                }
            }
        }
    }
}
