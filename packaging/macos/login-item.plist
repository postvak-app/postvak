<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Postvak.app's login item, which `autostart` registers with SMAppService; its label is LOGIN_ITEM_LABEL there. -->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>io.github.postvak_app.postvak.login</string>
    <key>BundleProgram</key>
    <string>Contents/MacOS/postvak</string>
    <key>ProgramArguments</key>
    <array>
        <string>postvak</string>
        <string>gui</string>
        <string>--background</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>LimitLoadToSessionType</key>
    <string>Aqua</string>
    <key>ProcessType</key>
    <string>Interactive</string>
</dict>
</plist>
