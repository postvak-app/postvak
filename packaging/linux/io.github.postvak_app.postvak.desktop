[Desktop Entry]
Type=Application
Name=Postvak
GenericName=Mail Client
Comment=Read and sort your mail
Exec=postvak gui %u
TryExec=postvak
Icon=io.github.postvak_app.postvak
Terminal=false
StartupNotify=true
StartupWMClass=io.github.postvak_app.postvak
SingleMainWindow=true
X-GNOME-UsesNotifications=true
Categories=Network;Email;
MimeType=x-scheme-handler/mailto;
Keywords=mail;email;IMAP;inbox;rules;
